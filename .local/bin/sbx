#!/usr/bin/env bash
# Run a command (default: a shell) in a sandbox for code you did not write: bubblewrap
# where it exists (Linux), srt (sandbox-runtime, Seatbelt) on macOS; the description
# below is the bwrap one, the srt differences are in its block further down.
# Only usable from inside ~/projects/untrusted or ~/worktrees/untrusted.
#
#   sbx [--offline] [--rw-git] [cmd args...]   e.g.  sbx bun install   sbx bun run dev
#
# Inside: / is read-only, $HOME is a throwaway dir per repo
# (~/.local/share/sbx/home/<repo>) so none of your ~/.ssh, ~/.config/gh,
# ~/.claude, dashlane files or ssh-agent exist; the environment is scrubbed; only
# the repo holding cwd is writable (or cwd itself outside any repo). mise trusts
# the untrusted trees inside the sandbox only and installs tools into
# ~/.local/share/sbx/mise, never into your real mise dir. Network is on unless
# --offline. This limits what a hostile postinstall or dev server can read or
# change; it is not a VM, so do not treat it as protection against kernel exploits.
#
# The repo's git dir is read-only inside: git on the host (your prompt, gwl, gws)
# runs whatever .git/config says (core.fsmonitor, core.sshCommand, hooks), so a
# writable .git would let sandboxed code run commands outside the sandbox.
# --rw-git lifts that for a git command that must write (commit, fetch); only use
# it for commands you trust, never for installs or dev servers.
#
#   sbx --audit TREE cmd...           run a PoC on a copy of TREE with enforced limits
#   sbx --audit-prepare TREE cmd...   same limits, TREE itself writable (install/build)
# Audit mode is bwrap only and meant for a disposable Linux VM; see the block below.
set -euo pipefail

die() { echo "sbx: $*" >&2; exit 1; }
net=--share-net rwgit=0 audit='' tree=''
while [ $# -gt 0 ]; do
  case $1 in
    --offline) net='' ;;
    --rw-git) rwgit=1 ;;
    --audit | --audit-prepare)
      [ -z "$audit" ] || die "--audit and --audit-prepare are mutually exclusive"
      [ $# -ge 2 ] || die "$1 needs a TREE"
      audit=${1#--} tree=$2
      shift
      ;;
    --) shift; break ;;
    *) break ;;
  esac
  shift
done

# bwrap where it exists (Linux), srt (Anthropic's sandbox-runtime: Seatbelt on macOS)
# elsewhere; SBX_BACKEND=bwrap|srt forces one
backend=${SBX_BACKEND:-}
if [ -z "$backend" ]; then
  if command -v bwrap >/dev/null; then backend=bwrap; else backend=srt; fi
fi
[ -z "$audit" ] || [ "$backend" = bwrap ] || die "--$audit needs the bwrap backend (Linux VM), not $backend"
case $backend in
  bwrap) command -v bwrap >/dev/null || die "bubblewrap not installed (apt install bubblewrap)" ;;
  srt) command -v srt >/dev/null || die "srt not installed (mise install)" ;;
  *) die "unknown SBX_BACKEND: $backend" ;;
esac

if [ -n "$audit" ]; then
  # Audit mode: run code from an untrusted repo with enforced limits, for a
  # disposable Linux VM (not a workstation). Offline always, a fresh tmpfs $HOME per
  # call, the toolchain read-only, and only /work writable: --audit copies TREE (bound
  # read-only) into a size-limited tmpfs there, --audit-prepare binds TREE itself at
  # /work (for offline install and build steps; same path, so absolute paths baked
  # into venvs and native builds still resolve in each --audit copy). Memory, task,
  # cpu and wall-clock caps come from a transient systemd scope, file size from
  # ulimit -f; each is overridable (SBX_AUDIT_MEM, _TASKS, _CPU, _TIME, _FSIZE_MB,
  # _WORK_MB, _SCRATCH_MB). Anything that cannot be enforced refuses to run.
  [ "$rwgit" = 0 ] || die "--$audit cannot be combined with --rw-git"
  [ -d "$tree" ] || die "TREE is not a directory: $tree"
  tree=$(cd "$tree" && pwd -P)
  command -v systemd-run >/dev/null || die "systemd-run not found: cannot apply --$audit limits"
  mem=${SBX_AUDIT_MEM:-2G} tasks=${SBX_AUDIT_TASKS:-256} cpu=${SBX_AUDIT_CPU:-100%} rtime=${SBX_AUDIT_TIME:-300}
  mb() { # mb <name> <default>: a positive integer from the env
    local v=${!1:-$2}
    case $v in '' | *[!0-9]* | 0) die "$1 must be a positive integer (MB), got: $v" ;; esac
    echo "$v"
  }
  fsize_mb=$(mb SBX_AUDIT_FSIZE_MB 1024) work_mb=$(mb SBX_AUDIT_WORK_MB 1024) scratch_mb=$(mb SBX_AUDIT_SCRATCH_MB 256)
  limits=(--user --scope --quiet -p "MemoryMax=$mem" -p MemorySwapMax=0 -p "TasksMax=$tasks" -p "CPUQuota=$cpu" -p "RuntimeMaxSec=$rtime")
  # a scope that starts is not proof the controllers are delegated: look at the
  # limits the cgroup actually got
  # shellcheck disable=SC2016 # expanded by the sh inside the scope
  probe='d=/sys/fs/cgroup$(sed -n "s/^0:://p" /proc/self/cgroup)
    for f in memory.max pids.max cpu.max; do
      v=$(cut -d" " -f1 "$d/$f" 2>/dev/null) && [ -n "$v" ] && [ "$v" != max ] || exit 1
    done'
  systemd-run "${limits[@]}" -- sh -c "$probe" sbx-probe >/dev/null 2>&1 ||
    die "cannot apply memory, task and cpu limits through a systemd user scope here (cgroup v2 with delegated controllers needed); refusing to run --$audit"

  state=$HOME/.local/share/sbx
  mkdir -p "$state/mise"
  args=(--unshare-all --die-with-parent --new-session
    --ro-bind /usr /usr --ro-bind /etc /etc
    --proc /proc --dev /dev
    --size $((scratch_mb * 1024 * 1024)) --tmpfs /tmp
    --size $((scratch_mb * 1024 * 1024)) --tmpfs "$HOME")
  for d in bin lib lib64 sbin; do
    if [ -L "/$d" ]; then args+=(--symlink "$(readlink "/$d")" "/$d"); elif [ -d "/$d" ]; then args+=(--ro-bind "/$d" "/$d"); fi
  done
  [ -x "$HOME/.local/bin/mise" ] && args+=(--ro-bind "$HOME/.local/bin/mise" "$HOME/.local/bin/mise")
  args+=(--ro-bind "$state/mise" "$HOME/.local/share/mise")
  if [ "$audit" = audit ]; then
    args+=(--ro-bind "$tree" /run/sbx-tree --size $((work_mb * 1024 * 1024)) --tmpfs /work)
  else
    args+=(--bind "$tree" /work)
    # host git runs whatever .git/config and hooks name, so a hostile build script
    # must not persist them (same rule as the normal mode): mounted over the bind
    if [ -e "$tree/.git" ]; then args+=(--ro-bind "$tree/.git" /work/.git); fi
  fi
  args+=(--chdir /work --clearenv
    --setenv HOME "$HOME" --setenv USER "${USER:-user}" --setenv TERM "${TERM:-xterm}"
    --setenv LANG "${LANG:-C.UTF-8}" --setenv SBX 1
    --setenv PATH "$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
    --setenv MISE_TRUSTED_CONFIG_PATHS /work)

  [ $# -gt 0 ] || set -- "${SHELL:-bash}"
  [ -x "$HOME/.local/bin/mise" ] && set -- "$HOME/.local/bin/mise" exec -- "$@"
  if [ "$audit" = audit ]; then
    set -- sh -c 'cp -a /run/sbx-tree/. /work/ && cd /work && exec "$@"' sbx-audit "$@"
  fi
  # shellcheck disable=SC2016 # expanded by the bash inside the scope
  exec systemd-run "${limits[@]}" -- \
    bash -c 'ulimit -f "$1" && shift && exec "$@"' sbx-limits $((fsize_mb * 1024)) \
    bwrap "${args[@]}" "$@"
fi

roots=("$HOME/projects/untrusted" "$HOME/worktrees/untrusted")
cwd=$(pwd -P)
ok=0
for r in "${roots[@]}"; do
  case $cwd in "$r" | "$r"/*) ok=1 ;; esac
done
[ "$ok" = 1 ] || die "run from inside ${roots[0]} or ${roots[1]} (cwd: $cwd)"

# the repo holding cwd: the nearest dir with a .git, stopping at the roots; found
# without running git, since this repo's git config is what is not trusted
repo=$cwd
while [ ! -e "$repo/.git" ]; do
  case $repo in "${roots[0]}" | "${roots[1]}" | /) repo=$cwd; break ;; esac
  repo=$(dirname "$repo")
done
# its git dirs: .git itself, or for a worktree the dir its .git file names plus
# the shared dir (commondir) that holds config and hooks
gitdirs=()
abs() { case $2 in /*) (cd "$2" && pwd -P) ;; *) (cd "$1/$2" && pwd -P) ;; esac; }
if [ -d "$repo/.git" ]; then
  gitdirs+=("$repo/.git")
elif [ -f "$repo/.git" ]; then
  gd=$(abs "$repo" "$(sed -n 's/^gitdir: //p' "$repo/.git")") || die "cannot resolve $repo/.git"
  gitdirs+=("$gd")
  if [ -f "$gd/commondir" ]; then gitdirs+=("$(abs "$gd" "$(cat "$gd/commondir")")"); fi
fi

state=$HOME/.local/share/sbx

if [ "$backend" = srt ]; then
  # srt cannot swap in a fresh $HOME, so it denies reads of the real one and
  # re-opens the repo, its git dirs, mise and bun binaries, and a cache dir of its
  # own (nothing shared with your real caches). Network is a registry allowlist
  # (SBX_DOMAINS adds hosts, space separated); --offline allows nothing. The
  # environment is scrubbed by running srt itself under env -i.
  command -v jq >/dev/null || die "jq not installed (mise install)"
  cache=$state/cache
  mkdir -p "$cache"
  # srt is a node script: the scrubbed PATH needs the dirs of srt itself and node
  # (mise which sees past the shims, which would not resolve under the scrubbed env)
  real() { mise which "$1" 2>/dev/null || command -v "$1"; }
  srtbin=$(real srt)
  srtpath=$(dirname "$srtbin")
  if node=$(real node); then srtpath=$srtpath:$(dirname "$node"); fi
  # NOTE: this is a hardcoded list and is NOT supplied by .claude/settings.json.fragment or any bot thing.
  # This is used for untrusted code i.e. ~/projects/untrusted (3rd parties)
  doms="firewall-api.socket.dev registry.npmjs.org pypi.org files.pythonhosted.org github.com *.githubusercontent.com ${SBX_DOMAINS:-}"
  [ -n "$net" ] || doms=''
  gitjson=$(printf '%s\n' ${gitdirs[@]+"${gitdirs[@]}"} | jq -R . | jq -s 'map(select(. != ""))')
  cfg=$(mktemp -d "${TMPDIR:-/tmp}/sbx.XXXXXX")
  trap 'rm -rf "$cfg"' EXIT
  jq -n --arg repo "$repo" --arg home "$HOME" --arg cache "$cache" --arg rwgit "$rwgit" \
    --argjson gits "$gitjson" --arg doms "$doms" '{
    network: {allowedDomains: ($doms | split(" ") | map(select(. != ""))), deniedDomains: []},
    filesystem: {
      denyRead: [$home],
      allowRead: ([$repo, $cache, "\($home)/.local/share/mise", "\($home)/.local/bin/mise", "\($home)/.bun/bin"] + $gits),
      allowWrite: ([$repo, $cache] + (if $rwgit == "1" then $gits else [] end)),
      denyWrite: (if $rwgit == "1" then [] else $gits end)
    }}' >"$cfg/settings.json"
  trusted=$(IFS=:; echo "${roots[*]}")
  cmd=("$@")
  [ ${#cmd[@]} -gt 0 ] || cmd=("${SHELL:-bash}")
  [ -x "$HOME/.local/bin/mise" ] && cmd=("$HOME/.local/bin/mise" exec -- "${cmd[@]}")
  # not exec: the trap above removes the settings dir afterwards
  env -i HOME="$HOME" USER="${USER:-user}" TERM="${TERM:-xterm}" LANG="${LANG:-C.UTF-8}" SBX=1 \
    PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$HOME/.bun/bin:$srtpath:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" \
    MISE_TRUSTED_CONFIG_PATHS="$trusted" MISE_CACHE_DIR="$cache/mise" MISE_STATE_DIR="$cache/mise-state" \
    XDG_CACHE_HOME="$cache/xdg" BUN_INSTALL_CACHE_DIR="$cache/bun" UV_CACHE_DIR="$cache/uv" UV_TOOL_DIR="$cache/uv-tools" \
    npm_config_cache="$cache/npm" \
    "$srtbin" --settings "$cfg/settings.json" -- "${cmd[@]}"
  exit
fi

# one throwaway HOME per repo, so one repo cannot plant dotfiles for another
home=$state/home/$(printf '%s' "${repo#"$HOME"/}" | tr '/' '%')
mkdir -p "$home" "$state"/mise

args=(--unshare-all --die-with-parent --new-session
  --ro-bind /usr /usr --ro-bind /etc /etc
  --proc /proc --dev /dev --tmpfs /tmp)
[ -n "$net" ] && args+=("$net")
for d in bin lib lib64 sbin; do # merged-/usr layouts keep these as symlinks
  if [ -L "/$d" ]; then args+=(--symlink "$(readlink "/$d")" "/$d"); elif [ -d "/$d" ]; then args+=(--ro-bind "/$d" "/$d"); fi
done
args+=(--bind "$home" "$HOME")
[ -x "$HOME/.local/bin/mise" ] && args+=(--ro-bind "$HOME/.local/bin/mise" "$HOME/.local/bin/mise")
args+=(--bind "$state/mise" "$HOME/.local/share/mise")
args+=(--bind "$repo" "$repo")
# after the repo bind, so these read-only mounts sit on top of it
if [ "$rwgit" = 0 ]; then
  for g in ${gitdirs[@]+"${gitdirs[@]}"}; do args+=(--ro-bind "$g" "$g"); done
else
  for g in ${gitdirs[@]+"${gitdirs[@]}"}; do args+=(--bind "$g" "$g"); done
fi
trusted=$(IFS=:; echo "${roots[*]}")
args+=(--chdir "$cwd" --clearenv
  --setenv HOME "$HOME" --setenv USER "${USER:-user}" --setenv TERM "${TERM:-xterm}"
  --setenv LANG "${LANG:-C.UTF-8}" --setenv SBX 1
  --setenv PATH "$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
  --setenv MISE_TRUSTED_CONFIG_PATHS "$trusted")

[ $# -gt 0 ] || set -- "${SHELL:-bash}"
if [ -x "$HOME/.local/bin/mise" ]; then
  exec bwrap "${args[@]}" "$HOME/.local/bin/mise" exec -- "$@"
fi
exec bwrap "${args[@]}" "$@"
