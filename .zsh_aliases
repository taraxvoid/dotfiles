# Cross-platform: tool-dependent aliases are only defined when the tool exists, so
# a fresh Linux box without eza/bat/nvim keeps working ls/cat/vim.
# macOS has no envsubst; GNU gettext provides the real one on Linux.
(( $+commands[envsubst] )) || alias envsubst='python3 -c '\''import os,sys;[sys.stdout.write(os.path.expandvars(l)) for l in sys.stdin]'\'
alias globurl='noglob urlglobber '
alias hd='hexdump -C'
alias help=run-help
alias hist='fc -li'
alias history-stat='history 0 | awk '\''{print $2}'\'' | sort | uniq -c | sort -n -r | head'
alias histsync='fc -RI'
(( $+commands[pip3] )) && alias pip=pip3
(( $+commands[python3] )) && alias python=python3
alias which-command=whence

(( $+commands[nvim] )) && alias vim=nvim

# custom
# Debian/Ubuntu name fd `fdfind`; elsewhere `fd` is already the real binary
(( $+commands[fdfind] && ! $+commands[fd] )) && alias fd="fdfind"
# fdsd <find> <replace> <glob> [-a|--all|--hidden]: replace the literal string
# <find> with <replace> in every file matching the fd --glob pattern, e.g.
# `fdsd foo bar *yaml -a`. The alias stops zsh expanding the glob; -a also
# searches hidden files (fd --hidden). Ignored files are still skipped.
unalias fdsd 2>/dev/null # re-sourcing (sz) would expand the alias below in the definition
fdsd() {
  local -a pos fdargs
  local a
  for a in "$@"; do
    case $a in
      -a|--all|--hidden) fdargs+=(--hidden) ;;
      *) pos+=("$a") ;;
    esac
  done
  if (( ${#pos} != 3 )); then
    print -u2 "usage: fdsd <find> <replace> <glob> [-a|--all|--hidden]"
    return 2
  fi
  (( $+commands[sd] )) || { print -u2 "fdsd: sd is not installed"; return 127 }
  fd --type f --glob $fdargs -0 -- "${pos[3]}" | xargs -0 -r sd -F -- "${pos[1]}" "${pos[2]}"
}
alias fdsd='noglob fdsd'
alias l="ls"
alias ll="ls -l"
alias la="ls -a"
(( $+commands[eza] )) && alias ls="eza"
alias gs="git status"
alias gb="git branch"
alias gd="git diff"
alias gl="git log -5"
alias lg="lazygit"
alias gwp="git worktree prune"
# gwr is a function below (fzf picker)
# bat is installed as `batcat` on Debian/Ubuntu
if (( $+commands[bat] )); then alias cat="bat"; elif (( $+commands[batcat] )); then alias cat="batcat"; fi
alias hcl="hcloud"
alias vlt="vultr-cli"
alias sz="source ~/.zshrc"
alias jc="just --choose"
alias vz="vim ~/.zshrc"
alias ve="vim ~/.zshenv"

# dashlane CLI https://cli.dashlane.com/install
alias dc='dcli'

# github CLI
alias grem="git remote -v"
# Shared jq for PR status, used by gps (decide on a PR) and gwl (scan worktrees).
# Colors are ANSI; rows come out as one line (fzf) or a 3-line block (table).
typeset -g _gh_pr_fields='number,title,author,headRefName,isDraft,reviewDecision,mergeable,mergeStateStatus,statusCheckRollup,reviewRequests,additions,deletions,changedFiles,updatedAt,autoMergeRequest'
typeset -g _gh_pr_jq_defs='
  def c(code; s): "\u001b[\(code)m\(s)\u001b[0m";
  def join_(a): a | map(select(. != "")) | join(" | ");
  def failing: [(.statusCheckRollup // [])[]
    | select((.conclusion // .state // "") | IN("FAILURE","ERROR","TIMED_OUT","CANCELLED","ACTION_REQUIRED"))
    | (.name // .context)] | unique;
  def checks:
    (.statusCheckRollup // []) as $r
    | if ($r | length) == 0 then c("2"; "no checks")
      elif (failing | length) > 0 then c("31"; "checks failing")
      elif any($r[]; (.status // "COMPLETED") != "COMPLETED" or (.state // "") == "PENDING") then c("33"; "checks pending")
      else c("32"; "checks passing") end;
  def review:
    if .isDraft then c("2"; "draft")
    elif .reviewDecision == "APPROVED" then c("32"; "approved")
    elif .reviewDecision == "CHANGES_REQUESTED" then c("31"; "changes requested")
    elif .reviewDecision == "REVIEW_REQUIRED" then c("33"; "review required")
    else c("2"; "no review") end;
  def merge:
    if .isDraft then ""
    elif .mergeable == "CONFLICTING" or .mergeStateStatus == "DIRTY" then c("31"; "conflicts")
    elif .mergeStateStatus == "BEHIND" then c("33"; "behind base")
    elif .mergeStateStatus == "BLOCKED" then c("33"; "blocked")
    elif .mergeStateStatus == "UNSTABLE" then c("33"; "non-required checks failing")
    elif .mergeStateStatus == "CLEAN" or .mergeStateStatus == "HAS_HOOKS" then c("32"; "ready to merge")
    else c("2"; "merge unknown") end;
  def age:
    ([now - (.updatedAt | fromdateiso8601), 0] | max) as $s
    | if $s < 3600 then "\($s / 60 | floor)m" elif $s < 86400 then "\($s / 3600 | floor)h" else "\($s / 86400 | floor)d" end;
  def who: if .author.login == $me then c("35"; "you") else .author.login end;
  def asked: if any(.reviewRequests[]?; .login == $me) then c("35"; "review requested") else "" end;
  def row: "\(.number)\t\(c("1;32"; "#\(.number)")) \(.title[0:60])  \(join_([who, checks, review, merge, asked]))";
  def block:
    "\(c("1;32"; "#\(.number)")) \(.title)  \(c("36"; .headRefName))\n"
    + "    \(join_([who, checks, review, merge, asked]))\n"
    + "    \(join_(["+\(.additions) -\(.deletions) in \(.changedFiles) files", "updated \(age) ago",
        (if .autoMergeRequest then c("36"; "auto-merge on") else "" end),
        (if (failing | length) > 0 then c("31"; "failing: \(failing | join(", "))") else "" end)]))";
  def pr_summary:
    if .state == "MERGED" then c("35"; "#\(.number) merged")
    elif .state == "CLOSED" then c("31"; "#\(.number) closed")
    else "#\(.number) \(join_([checks, review, merge]))" end;
'

# _gh_me: your GitHub login, cached in ~/.cache/zsh/gh-login so gps and friends skip
# a ~1s `gh api user` round trip. Refetched when gh's hosts.yml is newer (gh auth
# login/switch rewrites it); a failed lookup caches nothing.
_gh_me() {
  local f=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/gh-login hosts=${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}/hosts.yml me
  if [[ -s $f && ! $hosts -nt $f ]]; then
    cat $f
    return
  fi
  me=$(gh api user --jq .login) && [[ -n $me ]] || return 1
  mkdir -p ${f:h} && print -r -- $me >| $f
  print -r -- $me
}

# _page: pipe stdin through $PAGER (default less) when stdout is a terminal, else
# plain cat. -F quits at once if the output fits one screen, -X keeps it on screen.
_page() {
  if [[ -t 1 ]]; then LESS=${LESS:--FRX} ${=PAGER:-less}; else cat; fi
}

# gps: open PRs with what you need to decide on a merge (checks and which are
# failing, review state, merge state incl. behind/blocked/conflicts, size, age,
# auto-merge). On a terminal it is an fzf picker (preview = PR + checks) that
# leads to an action menu; `gps -l`, a pipe, or no fzf prints the plain table.
# `gps <N>` (or `#N`) skips the picker: it prints that PR's block, then the
# action menu (block only with -l, a pipe, or no fzf).
# Other args pass through to `gh pr list` (e.g. `gps --author @me`).
unalias gps 2>/dev/null
gps() {
  local list=0 me rows n
  [[ ${1:-} == (-l|--list) ]] && { list=1; shift }
  me=$(_gh_me) || return
  if [[ ${1:-} == (\#|)<-> ]]; then
    n=${1#\#}
    rows=$(gh pr view $n --json $_gh_pr_fields) || return
    print -r -- "$rows" | jq -r --arg me "$me" "$_gh_pr_jq_defs"'block'
    (( list )) || [[ ! -t 1 ]] || (( ! $+commands[fzf] )) || _gh_pr_act $n
    return
  fi
  if (( list )) || [[ ! -t 1 ]] || (( ! $+commands[fzf] )); then
    gh pr list --limit 100 "$@" --json $_gh_pr_fields \
    | jq -r --arg me "$me" "$_gh_pr_jq_defs"'
      if length == 0 then "No open PRs" else sort_by([(.author.login != $me), .number])[] | block end' \
    | _page
    return
  fi
  n=$(_gh_pr_pick 'PR> ' 'enter: actions' "$@") || return
  _gh_pr_act $n
}

# _gh_pr_pick <prompt> <header> [gh pr list args]: the gps fzf picker (yours first,
# preview = PR + checks); prints the picked PR number. Used by gps, gpo and gpm.
_gh_pr_pick() {
  local prompt=$1 header=$2 me rows pick
  shift 2
  me=$(_gh_me) || return
  rows=$(gh pr list --limit 100 "$@" --json $_gh_pr_fields \
    | jq -r --arg me "$me" "$_gh_pr_jq_defs"'sort_by([(.author.login != $me), .number])[] | row') || return
  [[ -n "$rows" ]] || { print -u2 "No open PRs"; return 1 }
  pick=$(print -r -- "$rows" | fzf --ansi --delimiter=$'\t' --with-nth=2 --prompt=$prompt \
    ${header:+--header=$header} --preview='gh pr view {1}; echo; gh pr checks {1}' \
    --preview-window=down,60%) || return 1
  print -r -- "${pick%%$'\t'*}"
}

# gpl: the gps table without the picker (args pass through to `gh pr list`)
unalias gpl 2>/dev/null
gpl() { gps -l "$@"; }

# Action menu for one PR number (called by gps). Merge, auto-merge and close ask first.
_gh_pr_act() {
  local n=$1 action
  action=$(printf '%s\n' approve "auto-merge (squash)" browser "checkout (cd to worktree)" checks close \
    diff "failed logs" "mark ready" "merge (merge commit)" "review or comment" "squash merge" "update branch" view \
    | fzf --prompt="#$n> " --height=~40%) || return 1
  case $action in
    view) gh pr view $n ;;
    diff) gh pr diff --color=always $n | _page ;;
    checks) gh pr checks $n ;;
    "failed logs") gj $n ;;
    "checkout (cd to worktree)") _gh_pr_checkout $n ;;
    "squash merge") read -q "?Squash-merge #$n? [y/N] " && { echo; gh pr merge $n --squash } ;;
    "merge (merge commit)") read -q "?Merge #$n with a merge commit? [y/N] " && { echo; gh pr merge $n --merge } ;;
    "auto-merge (squash)") read -q "?Enable auto-merge for #$n and delete the branch after? [y/N] " && { echo; gh pr merge $n --squash --auto --delete-branch } ;;
    approve) gh pr review $n --approve ;;
    "review or comment") gh pr review $n ;;
    "update branch") gh pr update-branch $n ;;
    "mark ready") gh pr ready $n ;;
    browser) gh pr view $n --web ;;
    close) read -q "?Close #$n and delete its branch? [y/N] " && { echo; gh pr close $n --delete-branch } ;;
  esac
}
alias ga="git add ."
alias gci="git commit"
alias grl="gh run list"
_gh_rerun_failed_branch() {
  local branch run_id
  branch=$(git branch --show-current)
  if [[ -z "$branch" ]]; then
    print -u2 -- "not on a branch"
    return 1
  fi
  run_id=$(gh run list --branch "$branch" --status failure --limit 1 --json databaseId --jq '.[0].databaseId')
  if [[ -z "$run_id" ]]; then
    print -u2 -- "no failed runs found for branch $branch"
    return 1
  fi
  gh run rerun --failed "$run_id"
}
alias grf=_gh_rerun_failed_branch

alias gma="git merge --abort"

# gpm: squash-merge. The PR is the first non-flag arg (number/URL/branch), else
# the current branch's open PR, else one picked from open PRs (same rows as gps).
# Always confirms first unless given -y/--yes (dropped before `gh pr merge`) or
# --auto (passed through). Other flags pass through (e.g. `gpm --admin`).
unalias gpm 2>/dev/null
gpm() {
  local target label a skip=0
  local -a args
  local -i i
  for a in "$@"; do
    case $a in
      -y|--yes) skip=1 ;;
      *) [[ $a == --auto ]] && skip=1; args+=("$a") ;;
    esac
  done
  # First non-flag arg is the PR; skip the values of flags that take one.
  for (( i = 1; i <= $#args; i++ )); do
    case ${args[i]} in
      -A|--author-email|-b|--body|-F|--body-file|--match-head-commit|-t|--subject|-R|--repo) (( i++ )) ;;
      -*) ;;
      *) target=${args[i]}; args[i]=(); break ;;
    esac
  done
  [[ -n $target ]] || target=$(gh pr view --json number,state -q 'select(.state == "OPEN") | .number' 2>/dev/null)
  if [[ -z $target ]]; then
    if [[ ! -t 1 ]] || (( ! $+commands[fzf] )); then
      gh pr merge --squash "${args[@]}"; return
    fi
    target=$(_gh_pr_pick 'PR merge> ' '') || return
  fi
  if (( ! skip )); then
    [[ $target == <-> ]] && label="#$target" || label=$target
    read -q "?Squash-merge $label${args:+ (${args[*]})}? [y/N] " || { echo; return 1 }
    echo
  fi
  gh pr merge $target --squash "${args[@]}"
}
# gpd: with args, paged `gh pr diff`; bare, pick an open PR (same rows as gps,
# preview = per-file change summary like `git diff --stat`) and page its full
# diff. Falls back to the current branch's PR with no fzf or no terminal.
unalias gpd 2>/dev/null
gpd() {
  local me pick
  if [[ ! -t 1 ]]; then gh pr diff "$@"; return; fi
  if (( $# )) || (( ! $+commands[fzf] )); then gh pr diff --color=always "$@" | _page; return; fi
  me=$(_gh_me) || return
  pick=$(gh pr list --limit 100 --json $_gh_pr_fields \
    | jq -r --arg me "$me" "$_gh_pr_jq_defs"'sort_by([(.author.login != $me), .number])[] | row' \
    | fzf --ansi --delimiter=$'\t' --with-nth=2 --prompt='PR diff> ' \
        --preview='gh pr diff {1} | git apply --stat' --preview-window=down,60%) || return 1
  gh pr diff --color=always "${pick%%$'\t'*}" | _page
}
alias gil="gh issue list"
alias gf="git fetch --all --tags"
alias gfp="git fetch --all && git pull"

# one-shot status of the current PR's checks (gpw is the --watch version)
alias gpc="gh pr checks"

# Resolve the databaseId of a PR's most recent run (current branch, or pass
# a PR number/branch). 
_gh_pr_run_id() {
  local ref="${1:-}"
  if [[ -n "$ref" ]]; then
    ref=$(gh pr view "$ref" --json headRefName -q .headRefName) || return 1
  else
    ref=$(git branch --show-current)
  fi
  gh run list --branch "$ref" --limit 1 --json databaseId -q '.[0].databaseId'
}

# Stream live job output for a PR's most recent run (current branch, or pass
# a PR number/branch). Unlike `gpc` (which polls check *status*), this tails
# the actual log via `gh run watch`. If the run already finished, `gh run
# watch` just prints a one-liner, so fall back to the full annotated summary
# (catches things like workflow-syntax failures that never produced jobs).
grw() {
  local ref="${1:-}" run_id run_status
  run_id=$(_gh_pr_run_id "$ref") || return 1
  if [[ -z "$run_id" ]]; then
    echo "no runs found for branch ${ref:-$(git branch --show-current)}" >&2
    return 1
  fi
  run_status=$(gh run view "$run_id" --json status -q .status)
  if [[ "$run_status" == "completed" ]]; then
    gh run view "$run_id"
  else
    gh run watch "$run_id" --exit-status
  fi
}

# Jump straight to the failed-step logs for a PR's most recent run (current
# branch, or pass a PR number/branch) — no manual `gh run list` + id lookup.
# Falls back to the annotated run summary when there's no log to fetch (e.g.
# the run succeeded, so --log-failed has nothing to print, or it failed
# before any job ran, like a workflow-syntax error).
gj() {
  local ref="${1:-}" run_id conclusion
  run_id=$(_gh_pr_run_id "$ref") || return 1
  if [[ -z "$run_id" ]]; then
    echo "no runs found for branch ${ref:-$(git branch --show-current)}" >&2
    return 1
  fi
  conclusion=$(gh run view "$run_id" --json conclusion -q .conclusion)
  if [[ "$conclusion" != "failure" ]]; then
    gh run view "$run_id"
    return
  fi
  local out
  out=$(gh run view "$run_id" --log-failed 2>/dev/null)
  if [[ -n "$out" ]]; then
    print -r -- "$out"
  else
    gh run view "$run_id"
  fi
}


# PRs (gp*)
alias gpv="gh pr view"
alias gpw="gh pr checks --watch"
# gpb: open the PR in the browser; if the branch has none yet, open the create-PR page instead
gpb() { gh pr view --web 2>/dev/null || gh pr create --web; }
alias gpn="gh pr create --fill"
alias gpndt="gh pr create --draft --title"
alias gpe="gh pr edit"
alias gpr="gh pr ready"
alias gpx="gh pr close --delete-branch"
alias gpma="gh pr merge --squash --auto --delete-branch"
alias gplm="gh pr list --author @me"
alias gpq="gh pr list --search 'review-requested:@me'"
alias gpcm="gh pr comment"
alias gpa="gh pr review --approve"
alias gprv="gh pr review"
alias gpu="gh pr update-branch"
alias gpdn="gh pr diff --name-only"

# push current branch and open a PR from the commits. On a worktree-<N>-<slug>
# branch, a multi-commit PR is titled from the slug instead of the raw branch
# name, and the body gets "Closes #N" above the commit list --fill would make.
# A -B/--base in the args is honored for the commit range; later --title/--body
# args override these.
gpp() {
  git push -u origin HEAD || return
  local branch=$(git branch --show-current)
  if [[ ! $branch =~ '^worktree-([0-9]+)-(.+)$' ]]; then
    gh pr create --fill "$@"
    return
  fi
  local issue=$match[1] slug=$match[2] base= arg prev=
  for arg in "$@"; do
    case $prev in -B|--base) base=$arg ;; esac
    case $arg in --base=*) base=${arg#--base=} ;; esac
    prev=$arg
  done
  if [[ -z $base ]]; then
    base=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
    base=${base#origin/}
    : ${base:=main}
  fi
  local range=origin/$base..HEAD title body
  if (( $(git rev-list --count $range) == 1 )); then
    title=$(git log -1 --format=%s)
    body=$(git log -1 --format=%b)
  else
    title=${slug//-/ }
    body=$(git log --reverse --format='- **%s**' $range)
  fi
  body="Closes #$issue${body:+

$body}"
  gh pr create --title "$title" --body "$body" "$@"
}

# Issues (gi*)
alias gin="gh issue create --title"
