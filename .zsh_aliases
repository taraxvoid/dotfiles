# Cross-platform: tool-dependent aliases are only defined when the tool exists, so
# a fresh Linux box without eza/bat/nvim keeps working ls/cat/vim.
# macOS has no envsubst; GNU gettext provides the real one on Linux.
(( $+commands[envsubst] )) || alias envsubst='python3 -c '\''import os,sys;[sys.stdout.write(os.path.expandvars(l)) for l in sys.stdin]'\'
alias globurl='noglob urlglobber '
alias hd='hexdump -C'
alias help=run-help
alias hist='fc -li'
alias history-stat='history 0 | awk '\''{print $2}'\'' | sort | uniq -c | sort -n -r | head'
alias histsync='fc -RI'
(( $+commands[pip3] )) && alias pip=pip3
(( $+commands[python3] )) && alias python=python3
alias which-command=whence

(( $+commands[nvim] )) && alias vim=nvim

