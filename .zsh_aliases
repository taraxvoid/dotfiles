# Cross-platform: tool-dependent aliases are only defined when the tool exists, so
# a fresh Linux box without eza/bat/nvim keeps working ls/cat/vim.
# macOS has no envsubst; GNU gettext provides the real one on Linux.
(( $+commands[envsubst] )) || alias envsubst='python3 -c '\''import os,sys;[sys.stdout.write(os.path.expandvars(l)) for l in sys.stdin]'\'
alias globurl='noglob urlglobber '
alias hd='hexdump -C'
alias help=run-help
alias hist='fc -li'
alias history-stat='history 0 | awk '\''{print $2}'\'' | sort | uniq -c | sort -n -r | head'
alias histsync='fc -RI'
(( $+commands[pip3] )) && alias pip=pip3
(( $+commands[python3] )) && alias python=python3
alias which-command=whence

(( $+commands[nvim] )) && alias vim=nvim

# custom
# Debian/Ubuntu name fd `fdfind`; elsewhere `fd` is already the real binary
(( $+commands[fdfind] && ! $+commands[fd] )) && alias fd="fdfind"
# fdsd <find> <replace> (<glob>|-a|--all) [--hidden]: replace the literal
# string <find> with <replace> in every file under the current dir matching
# the fd --glob pattern, or in every file with -a/--all, e.g.
# `fdsd foo bar *yaml` or `fdsd foo bar -a`. The alias stops zsh expanding the
# glob. Hidden files are only touched with --hidden; ignored files are skipped.
unalias fdsd 2>/dev/null # re-sourcing (sz) would expand the alias below in the definition
fdsd() {
  local -a pos fdargs
  local a all=0
  for a in "$@"; do
    case $a in
      -a|--all) all=1 ;;
      --hidden) fdargs+=(--hidden) ;;
      *) pos+=("$a") ;;
    esac
  done
  if (( ${#pos} != 3 - all )); then
    print -u2 "usage: fdsd <find> <replace> (<glob>|-a|--all) [--hidden]"
    return 2
  fi
  (( $+commands[sd] )) || { print -u2 "fdsd: sd is not installed"; return 127 }
  (( all )) || fdargs+=(--glob -- "${pos[3]}")
  fd --type f -0 $fdargs | xargs -0 -r sd -F -- "${pos[1]}" "${pos[2]}"
}
alias fdsd='noglob fdsd'
alias sz="source ~/.zshrc"
alias jc="just --choose"
alias vz="vim ~/.zshrc"
alias ve="vim ~/.zshenv"

alias l="ls"
alias ll="ls -l"
alias la="ls -a"
(( $+commands[eza] )) && alias ls="eza"
#: gs -- git status
alias gs="git status"
#: gb -- git branch
alias gb="git branch"
#: gd -- git diff
alias gd="git diff"
#: gdm - git diff against local main
alias gdm="git diff main"
#: gl -- git log, last 5 commits
alias gl="git log -5"
alias lg="lazygit"
#: grs -- git restore --staged - unstage staged files
alias grs="git restore --staged ."
#: gra -- git restore --staged - THROW AWAY unstaged files
alias gra="git restore ."
#: grb - git rebase - rebase branch
alias gra="git rebase"


# y [dir]: yazi, then cd to wherever it was left (q; Q quits without moving)
if (( $+commands[yazi] )); then
  y() {
    local tmp=$(mktemp -t yazi-cwd.XXXXXX) cwd
    command yazi "$@" --cwd-file="$tmp"
    cwd=$(<$tmp)
    [[ -n $cwd && $cwd != $PWD && -d $cwd ]] && builtin cd -- "$cwd"
    command rm -f -- "$tmp"
  }
fi
#: gwp -- prune stale worktree records
alias gwp="git worktree prune"
# gwr is a function below (fzf picker)
# bat is installed as `batcat` on Debian/Ubuntu
if (( $+commands[bat] )); then alias cat="bat"; elif (( $+commands[batcat] )); then alias cat="batcat"; fi

# CLIs
alias hcl="hcloud"
alias vlt="vultr-cli"

# dashlane CLI https://cli.dashlane.com/install
alias dc='dcli'

# github CLI
# Each git/gh shortcut has a `#: <usage> -- <what it does>` line above it; ghelp
# prints those lines. Add one when adding a shortcut (tests/zsh-aliases.bats checks).
typeset -g _zsh_aliases_file=${${(%):-%x}:A}
#: ghelp [word] -- list these shortcuts, or only those whose usage or description mentions word
unalias ghelp 2>/dev/null
ghelp() {
  local line
  while IFS= read -r line; do
    [[ $line == '#: '* ]] || continue
    line=${line#'#: '}
    [[ -z ${1:-} || ${(L)line} == *${(L)1}* ]] || continue
    printf '%-28s %s\n' "${line%% -- *}" "${line#* -- }"
  done <$_zsh_aliases_file
}
#: grem -- list git remotes with their URLs
alias grem="git remote -v"
# Shared jq for PR status, used by gps (decide on a PR) and gwl (scan worktrees).
# Colors are ANSI; rows come out as one line (fzf) or a 3-line block (table).
typeset -g _gh_pr_fields='number,title,author,headRefName,baseRefName,isDraft,reviewDecision,mergeable,mergeStateStatus,statusCheckRollup,reviewRequests,additions,deletions,changedFiles,updatedAt,autoMergeRequest'
typeset -g _gh_pr_jq_defs='
  def c(code; s): "\u001b[\(code)m\(s)\u001b[0m";
  def join_(a): a | map(select(. != "")) | join(" | ");
  def failing: [(.statusCheckRollup // [])[]
    | select((.conclusion // .state // "") | IN("FAILURE","ERROR","TIMED_OUT","CANCELLED","ACTION_REQUIRED"))
    | (.name // .context)] | unique;
  def checks:
    (.statusCheckRollup // []) as $r
    | if ($r | length) == 0 then c("2"; "no checks")
      elif (failing | length) > 0 then c("31"; "checks failing")
      elif any($r[]; (.status // "COMPLETED") != "COMPLETED" or (.state // "") == "PENDING") then c("33"; "checks pending")
      else c("32"; "checks passing") end;
  def review:
    if .isDraft then c("2"; "draft")
    elif .reviewDecision == "APPROVED" then c("32"; "approved")
    elif .reviewDecision == "CHANGES_REQUESTED" then c("31"; "changes requested")
    elif .reviewDecision == "REVIEW_REQUIRED" then c("33"; "review required")
    else c("2"; "no review") end;
  def merge:
    if .isDraft then ""
    elif .mergeable == "CONFLICTING" or .mergeStateStatus == "DIRTY" then c("31"; "conflicts")
    elif .mergeStateStatus == "BEHIND" then c("33"; "behind base")
    elif .mergeStateStatus == "BLOCKED" then c("33"; "blocked")
    elif .mergeStateStatus == "UNSTABLE" then c("33"; "non-required checks failing")
    elif .mergeStateStatus == "CLEAN" or .mergeStateStatus == "HAS_HOOKS" then c("32"; "ready to merge")
    else c("2"; "merge unknown") end;
  def age:
    ([now - (.updatedAt | fromdateiso8601), 0] | max) as $s
    | if $s < 3600 then "\($s / 60 | floor)m" elif $s < 86400 then "\($s / 3600 | floor)h" else "\($s / 86400 | floor)d" end;
  def who: if .author.login == $me then c("35"; "you") else .author.login end;
  def asked: if any(.reviewRequests[]?; .login == $me) then c("35"; "review requested") else "" end;
  def row: "\(.number)\t\(c("1;32"; "#\(.number)")) \(.title[0:60])  \(join_([who, checks, review, merge, asked]))";
  def block:
    "\(c("1;32"; "#\(.number)")) \(.title)  \(c("36"; .headRefName)) \(c("2"; "(base \(.baseRefName))"))\n"
    + "    \(join_([who, checks, review, merge, asked]))\n"
    + "    \(join_(["+\(.additions) -\(.deletions) in \(.changedFiles) files", "updated \(age) ago",
        (if .autoMergeRequest then c("36"; "auto-merge on") else "" end),
        (if (failing | length) > 0 then c("31"; "failing: \(failing | join(", "))") else "" end)]))";
  def pr_summary:
    if .state == "MERGED" then c("35"; "#\(.number) merged")
    elif .state == "CLOSED" then c("31"; "#\(.number) closed")
    else "#\(.number) \(join_([checks, review, merge]))" end;
'

# _gh_me: your GitHub login, cached in ~/.cache/zsh/gh-login so gps and friends skip
# a ~1s `gh api user` round trip. Refetched when gh's hosts.yml is newer (gh auth
# login/switch rewrites it); a failed lookup caches nothing.
_gh_me() {
  local f=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/gh-login hosts=${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}/hosts.yml me
  if [[ -s $f && ! $hosts -nt $f ]]; then
    cat $f
    return
  fi
  me=$(gh api user --jq .login) && [[ -n $me ]] || return 1
  mkdir -p ${f:h} && print -r -- $me >| $f
  print -r -- $me
}

# _page: pipe stdin through $PAGER (default less) when stdout is a terminal, else
# plain cat. -F quits at once if the output fits one screen, -X keeps it on screen.
_page() {
  if [[ -t 1 ]]; then LESS=${LESS:--FRX} ${=PAGER:-less}; else cat; fi
}

# Bare commands act on the current branch when that is safe: its open PR
# (_gh_pr_current) or, on a worktree-<N>-<slug> branch, issue N (_gh_branch_issue).
# Destructive ones (gpm, gpx, gic) ask first via _confirm unless given -y/--yes.
_gh_pr_current() {
  local n
  n=$(gh pr view --json number,state -q 'select(.state == "OPEN") | .number' 2>/dev/null)
  [[ -n $n ]] && print -r -- $n
}
_gh_branch_issue() {
  [[ $(git branch --show-current 2>/dev/null) =~ '^worktree-([0-9]+)-' ]] && print -r -- $match[1]
}
# _confirm <question>: y/N prompt, default no
_confirm() {
  local r
  # print the prompt ourselves: zsh's `read -q "?prompt"` drops it without a tty
  # (as in CI), and a silent default-no is a bad way to ask
  print -nu2 -- "$1 [y/N] "
  read -q
  r=$?
  echo
  return $r
}

# gps: open PRs with what you need to decide on a merge (checks and which are
# failing, review state, merge state incl. behind/blocked/conflicts, size, age,
# auto-merge). On a terminal it is an fzf picker (preview = PR + checks) that
# leads to an action menu; `gps -l`, a pipe, or no fzf prints the plain table.
# `gps <N>` (or `#N`) skips the picker: it prints that PR's block, then the
# action menu (block only with -l, a pipe, or no fzf).
# Other args pass through to `gh pr list` (e.g. `gps --author @me`).
#: gps [-l] [N] [list args] -- open PRs with checks, review and merge state; picker, then an action menu
unalias gps 2>/dev/null
gps() {
  local list=0 me rows n
  [[ ${1:-} == (-l|--list) ]] && { list=1; shift }
  me=$(_gh_me) || return
  if [[ ${1:-} == (\#|)<-> ]]; then
    n=${1#\#}
    rows=$(gh pr view $n --json $_gh_pr_fields) || return
    print -r -- "$rows" | jq -r --arg me "$me" "$_gh_pr_jq_defs"'block'
    (( list )) || [[ ! -t 1 ]] || (( ! $+commands[fzf] )) || _gh_pr_act $n
    return
  fi
  if (( list )) || [[ ! -t 1 ]] || (( ! $+commands[fzf] )); then
    gh pr list --limit 100 "$@" --json $_gh_pr_fields \
    | jq -r --arg me "$me" "$_gh_pr_jq_defs"'
      if length == 0 then "No open PRs" else sort_by([(.author.login != $me), .number])[] | block end' \
    | _page
    return
  fi
  n=$(_gh_pr_pick 'PR> ' 'enter: actions' "$@") || return
  _gh_pr_act $n
}

# _gh_pr_pick <prompt> <header> [gh pr list args]: the gps fzf picker (yours first,
# preview = PR + checks); prints the picked PR number. Used by gps, gpo and gpm.
_gh_pr_pick() {
  local prompt=$1 header=$2 me rows pick
  shift 2
  me=$(_gh_me) || return
  rows=$(gh pr list --limit 100 "$@" --json $_gh_pr_fields \
    | jq -r --arg me "$me" "$_gh_pr_jq_defs"'sort_by([(.author.login != $me), .number])[] | row') || return
  [[ -n "$rows" ]] || { print -u2 "No open PRs"; return 1 }
  pick=$(print -r -- "$rows" | fzf --ansi --delimiter=$'\t' --with-nth=2 --prompt=$prompt \
    ${header:+--header=$header} --preview='gh pr view {1}; echo; gh pr checks {1}' \
    --preview-window=down,60%) || return 1
  print -r -- "${pick%%$'\t'*}"
}

# gpl: the gps table without the picker (args pass through to `gh pr list`)
#: gpl [list args] -- the gps table, no picker
unalias gpl 2>/dev/null
gpl() { gps -l "$@"; }

# Action menu for one PR number (called by gps). Merge, auto-merge and close ask first.
_gh_pr_act() {
  local n=$1 action
  action=$(printf '%s\n' approve "automerge (squash)" browser "checkout (cd worktree)" checks close \
    diff logs "merge (commit)" "merge (squash)" ready review "update (base)" view watch \
    | fzf --prompt="#$n> " --height=~40%) || return 1
  case $action in
    view) gh pr view $n ;;
    diff) gh pr diff --color=always $n | _page ;;
    checks) gh pr checks $n ;;
    "logs") gj $n ;;
    "checkout (cd worktree)") _gh_pr_checkout $n ;;
    "merge (squash)") read -q "?Squash-merge #$n? [y/N] " && { echo; gh pr merge $n --squash } ;;
    "merge (commit)") read -q "?Merge #$n with a merge commit? [y/N] " && { echo; gh pr merge $n --merge } ;;
    "automerge (squash)") read -q "?Enable auto-merge for #$n and delete the branch after? [y/N] " && { echo; gh pr merge $n --squash --auto --delete-branch } ;;
    approve) gh pr review $n --approve ;;
    review) gh pr review $n ;;
    "update (base)") gh pr update-branch $n ;;
    watch) gh pr checks $n --watch ;;
    ready) gh pr ready $n ;;
    browser) gh pr view $n --web ;;
    close) read -q "?Close #$n and delete its branch? [y/N] " && { echo; gh pr close $n --delete-branch } ;;
  esac
}
#: ga -- stage everything (git add .)
alias ga="git add ."
#: gci -- git commit
alias gci="git commit"
#: grl -- list recent workflow runs
alias grl="gh run list"
_gh_rerun_failed_branch() {
  local branch run_id
  branch=$(git branch --show-current)
  if [[ -z "$branch" ]]; then
    print -u2 -- "not on a branch"
    return 1
  fi
  run_id=$(gh run list --branch "$branch" --status failure --limit 1 --json databaseId --jq '.[0].databaseId')
  if [[ -z "$run_id" ]]; then
    print -u2 -- "no failed runs found for branch $branch"
    return 1
  fi
  gh run rerun --failed "$run_id"
}
#: grf -- rerun only the failed jobs of this branch's latest failed run
alias grf=_gh_rerun_failed_branch

#: gma -- abort an in-progress merge
alias gma="git merge --abort"

# gpm: squash-merge. The PR is the first non-flag arg (number/URL/branch), else
# the current branch's open PR, else one picked from open PRs (same rows as gps).
# Defaults to auto-merge (--auto) when the repo allows it and the PR is still
# waiting on something (merge state BLOCKED or BEHIND); otherwise, or with
# --no-auto or --admin, it merges now. Auto-merge does not ask; merging now
# confirms first unless given -y/--yes (dropped before `gh pr merge`) or an
# explicit --auto (passed through). Other flags pass through (e.g. `gpm --admin`).
#: gpm [pr] [-y] [--no-auto] [merge flags] -- squash-merge (this branch's PR, else pick one); auto-merge when the repo allows it, else confirms unless -y
unalias gpm 2>/dev/null
gpm() {
  local target label a repo REPLY skip=0 auto=1
  local -a args
  local -i i
  for a in "$@"; do
    case $a in
      -y|--yes) skip=1 ;;
      --no-auto) auto=0 ;;
      --auto) skip=1; auto=0; args+=("$a") ;;
      --admin) auto=0; args+=("$a") ;;
      *) args+=("$a") ;;
    esac
  done
  # First non-flag arg is the PR; skip the values of flags that take one.
  for (( i = 1; i <= $#args; i++ )); do
    case ${args[i]} in
      -R|--repo) repo=${args[i+1]-}; (( i++ )) ;;
      -A|--author-email|-b|--body|-F|--body-file|--match-head-commit|-t|--subject) (( i++ )) ;;
      -*) ;;
      *) target=${args[i]}; args[i]=(); break ;;
    esac
  done
  [[ -n $target ]] || target=$(_gh_pr_current)
  if [[ -z $target ]]; then
    if [[ ! -t 1 ]] || (( ! $+commands[fzf] )); then
      gh pr merge --squash "${args[@]}"; return
    fi
    target=$(_gh_pr_pick 'PR merge> ' '') || return
  fi
  [[ $target == <-> ]] && label="#$target" || label=$target
  if (( auto )) && _gh_pr_auto_ok $target $repo; then
    print -u2 -- "Enabling auto-merge for $label (merge state $REPLY)"
    gh pr merge $target --squash --auto "${args[@]}"
    return
  fi
  if (( ! skip )); then
    _confirm "Squash-merge $label${args:+ (${args[*]})}?" || return 1
  fi
  gh pr merge $target --squash "${args[@]}"
}
# _gh_pr_auto_ok <pr> [repo]: true when auto-merge can and should be enabled on
# the PR: its repo allows it (allow_auto_merge, false or absent where the plan
# lacks it, e.g. private repos on a free personal plan) and the PR is not
# mergeable yet (merge state BLOCKED or BEHIND; GitHub refuses auto-merge on a
# PR that could merge now). Sets REPLY to the merge state.
_gh_pr_auto_ok() {
  local info url state
  info=$(gh pr view $1 ${2:+-R $2} --json url,mergeStateStatus -q '[.url, .mergeStateStatus] | @tsv' 2>/dev/null) || return 1
  url=${info%%$'\t'*} state=${info#*$'\t'}
  [[ $state == (BLOCKED|BEHIND) ]] || return 1
  [[ $url =~ '^https://[^/]+/([^/]+/[^/]+)/pull/' ]] || return 1
  [[ $(gh api repos/$match[1] -q '.allow_auto_merge // false' 2>/dev/null) == true ]] || return 1
  REPLY=$state
}
# gpx: close a PR and delete its branch. The PR is the first non-flag arg
# (number/URL/branch), else the current branch's open PR. Always confirms first
# unless given -y/--yes; other flags pass through to `gh pr close`.
#: gpx [pr] -- close a PR and delete its branch; bare, this branch's PR (confirms)
unalias gpx 2>/dev/null
gpx() {
  local target label a yes=0
  local -a args
  local -i i
  for a in "$@"; do
    case $a in -y|--yes) yes=1 ;; *) args+=("$a") ;; esac
  done
  for (( i = 1; i <= $#args; i++ )); do
    case ${args[i]} in
      -c|--comment|-R|--repo) (( i++ )) ;;
      -*) ;;
      *) target=${args[i]}; args[i]=(); break ;;
    esac
  done
  [[ -n $target ]] || target=$(_gh_pr_current) || { print -u2 "gpx: this branch has no open PR"; return 1 }
  if (( ! yes )); then
    [[ $target == <-> ]] && label="#$target" || label=$target
    _confirm "Close $label and delete its branch?" || return 1
  fi
  gh pr close $target --delete-branch "${args[@]}"
}
# gpd: with args, paged `gh pr diff`. Bare, the current branch's open PR (its
# diff against the base branch); with no such PR, or with -p/--pick, pick an
# open PR (same rows as gps, preview = per-file change summary like
# `git diff --stat`) and page its full diff. No fzf or no terminal: plain
# `gh pr diff` on the current branch.
#: gpd [pr] -- paged PR diff; bare, this branch's PR, else pick one
unalias gpd 2>/dev/null
gpd() {
  local me pick
  if [[ ! -t 1 ]]; then gh pr diff "$@"; return; fi
  if [[ ${1:-} == (-p|--pick) ]]; then
    shift
  elif (( $# )) || (( ! $+commands[fzf] )) || _gh_pr_current >/dev/null; then
    gh pr diff --color=always "$@" | _page; return
  fi
  me=$(_gh_me) || return
  pick=$(gh pr list --limit 100 "$@" --json $_gh_pr_fields \
    | jq -r --arg me "$me" "$_gh_pr_jq_defs"'sort_by([(.author.login != $me), .number])[] | row' \
    | fzf --ansi --delimiter=$'\t' --with-nth=2 --prompt='PR diff> ' \
        --preview='gh pr diff {1} | git apply --stat' --preview-window=down,60%) || return 1
  gh pr diff --color=always "${pick%%$'\t'*}" | _page
}
#: gil -- list open issues
alias gil="gh issue list"
#: gf -- fetch all remotes and tags
alias gf="git fetch --all --tags"
#: gfp -- fetch all remotes, then pull
alias gfp="git fetch --all && git pull"
#: gfm -- fetch all remotes, merge origin/main
alias gfm="git fetch --all && git merge origin/main"
#: gfn -- fetch all remotes, merge origin/next
alias gfn="git fetch --all && git merge origin/next"

# one-shot status of the current PR's checks (gpw is the --watch version)
#: gpc [pr] -- PR check status, once
alias gpc="gh pr checks"

# Resolve the databaseId of a PR's most recent run (current branch, or pass
# a PR number/branch). 
_gh_pr_run_id() {
  local ref="${1:-}"
  if [[ -n "$ref" ]]; then
    ref=$(gh pr view "$ref" --json headRefName -q .headRefName) || return 1
  else
    ref=$(git branch --show-current)
  fi
  gh run list --branch "$ref" --limit 1 --json databaseId -q '.[0].databaseId'
}

# Stream live job output for a PR's most recent run (current branch, or pass
# a PR number/branch). Unlike `gpc` (which polls check *status*), this tails
# the actual log via `gh run watch`. If the run already finished, `gh run
# watch` just prints a one-liner, so fall back to the full annotated summary
# (catches things like workflow-syntax failures that never produced jobs).
#: grw [pr] -- stream the live log of the PR's latest run (summary if it finished)
grw() {
  local ref="${1:-}" run_id run_status
  run_id=$(_gh_pr_run_id "$ref") || return 1
  if [[ -z "$run_id" ]]; then
    echo "no runs found for branch ${ref:-$(git branch --show-current)}" >&2
    return 1
  fi
  run_status=$(gh run view "$run_id" --json status -q .status)
  if [[ "$run_status" == "completed" ]]; then
    gh run view "$run_id"
  else
    gh run watch "$run_id" --exit-status
  fi
}

# Jump straight to the failed-step logs for a PR's most recent run (current
# branch, or pass a PR number/branch) - no manual `gh run list` + id lookup.
# Falls back to the annotated run summary when there's no log to fetch (e.g.
# the run succeeded, so --log-failed has nothing to print, or it failed
# before any job ran, like a workflow-syntax error).
#: gj [pr] -- failed-step logs of the PR's latest run
gj() {
  local ref="${1:-}" run_id conclusion
  run_id=$(_gh_pr_run_id "$ref") || return 1
  if [[ -z "$run_id" ]]; then
    echo "no runs found for branch ${ref:-$(git branch --show-current)}" >&2
    return 1
  fi
  conclusion=$(gh run view "$run_id" --json conclusion -q .conclusion)
  if [[ "$conclusion" != "failure" ]]; then
    gh run view "$run_id"
    return
  fi
  local out
  out=$(gh run view "$run_id" --log-failed 2>/dev/null)
  if [[ -n "$out" ]]; then
    print -r -- "$out"
  else
    gh run view "$run_id"
  fi
}


# PRs (gp*)
#: gpv [pr] -- view a PR
alias gpv="gh pr view"
#: gpw [pr] -- watch PR checks until they finish
alias gpw="gh pr checks --watch"
# gpb: open the PR in the browser; if the branch has none yet, open the create-PR page instead
#: gpb -- open this branch's PR in the browser, or the create-PR page
gpb() { gh pr view --web 2>/dev/null || gh pr create --web; }
#: gpn [create args] -- create a PR, title and body from the commits
alias gpn="gh pr create --fill"
#: gpndt <title> -- create a draft PR with that title
alias gpndt="gh pr create --draft --title"
#: gpe [pr] -- edit a PR (title, body, labels, reviewers...)
alias gpe="gh pr edit"
#: gpr [pr] -- mark a draft PR ready for review
alias gpr="gh pr ready"
#: gpma [pr] -- turn on squash auto-merge, delete the branch after
alias gpma="gh pr merge --squash --auto --delete-branch"
#: gplm -- your open PRs
alias gplm="gh pr list --author @me"
#: gpq -- PRs waiting on your review
alias gpq="gh pr list --search 'review-requested:@me'"
#: gpcm [pr] -- comment on a PR
alias gpcm="gh pr comment"
#: gpa [pr] -- approve a PR
alias gpa="gh pr review --approve"
#: gprv [pr] -- review a PR (approve, comment or request changes)
alias gprv="gh pr review"
#: gpu [pr] -- update the PR branch from its base
alias gpu="gh pr update-branch"
#: gpdn [pr] -- names of the files a PR changes
alias gpdn="gh pr diff --name-only"

# push current branch and open a PR from the commits. A single-commit PR takes
# that commit's subject as its title. A multi-commit one is titled
# "branch:<branch> - <summary>", the summary being issue #N's title on a
# worktree-<N>-<slug> branch (the slug if gh can't fetch it), else the oldest
# commit's subject plus "(+N more)". On worktree-<N>-* branches the body gets
# "Closes #N" above the branch's own commits (first parent, no merges, so
# commits pulled in by merging the base stay out); other branches keep --fill.
# -B/--base (-Bx, -B x, --base x, --base=x) picks the base for both gh and the
# commit range. The base is fetched first so a stale origin/<base> can't
# inflate the list, and a base with no shared history aborts before pushing.
# Later --title/--body args override these.
#: gpp [-B base] [create args] -- push this branch and open a PR (Closes #N on worktree-<N>-* branches)
gpp() {
  local branch=$(git branch --show-current) base= arg prev=
  for arg in "$@"; do
    case $prev in -B|--base) base=$arg ;; esac
    case $arg in --base=*) base=${arg#--base=} ;; -B?*) base=${arg#-B} ;; esac
    prev=$arg
  done
  if [[ -z $base ]]; then
    base=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
    base=${base#origin/}
    : ${base:=main}
  fi
  git fetch -q origin "$base" || return
  if ! git merge-base origin/$base HEAD >/dev/null; then
    print -u2 -- "gpp: $branch shares no history with origin/$base"
    return 1
  fi
  git push -u origin HEAD || return
  local -a own=( $(git rev-list --reverse --first-parent --no-merges origin/$base..HEAD) )
  local issue= slug= title body summary
  if [[ $branch =~ '^worktree-([0-9]+)-(.+)$' ]]; then
    issue=$match[1] slug=$match[2]
  fi
  if (( $#own == 1 )); then
    title=$(git log -1 --format=%s $own[1])
    body=$(git log -1 --format=%b $own[1])
  else
    if [[ -n $issue ]]; then
      summary=$(gh issue view $issue --json title -q .title 2>/dev/null)
      : ${summary:=${slug//-/ }}
    elif (( $#own )); then
      summary="$(git log -1 --format=%s $own[1]) (+$(( $#own - 1 )) more)"
    fi
    title="branch:$branch${summary:+ - $summary}"
    body=$(git log --reverse --first-parent --no-merges --format='- **%s**' origin/$base..HEAD)
  fi
  if [[ -z $issue ]]; then
    gh pr create --fill --title "$title" "$@"
    return
  fi
  body="Closes #$issue${body:+

$body}"
  gh pr create --title "$title" --body "$body" "$@"
}

# Issues (gi*)
#: gin <title> -- create an issue
alias gin="gh issue create --title"
#: gim -- issues assigned to you
alias gim="gh issue list --assignee @me"

# Runs and workflows (gr*; gw* is worktrees)
#: grvl [run] -- view a workflow run
alias grvl="gh run view"
#: grlg [run] -- full log of a workflow run
alias grlg="gh run view --log"
#: grx [run] -- cancel a workflow run
alias grx="gh run cancel"
# full rerun of the current branch's latest run (grf = failed only); any args
# pass straight through to `gh run rerun` (e.g. a run id, --job, --debug)
#: grr [run | rerun args] -- rerun this branch's latest run in full (grf = failed jobs only)
unalias grr 2>/dev/null
grr() {
  if (( $# )); then
    gh run rerun "$@"
    return
  fi
  local run_id
  run_id=$(_gh_pr_run_id) || return 1
  if [[ -z "$run_id" ]]; then
    print -u2 -- "no runs found for branch $(git branch --show-current)"
    return 1
  fi
  gh run rerun "$run_id"
}
#: grd [run] -- download a run's artifacts
alias grd="gh run download"
#: grb -- workflow runs for this branch
alias grb='gh run list --branch "$(git branch --show-current)"'
#: gwfl -- list workflows
alias gwfl="gh workflow list"
#: gwfr [workflow] -- trigger a workflow (workflow_dispatch)
alias gwfr="gh workflow run"

# Repo
#: gbw [path] -- open the repo (or a file in it) in the browser
alias gbw="gh browse"
#: gcl <repo> -- clone a GitHub repo
alias gcl="gh repo clone"
#: gfk <repo> -- fork a repo and clone the fork
alias gfk="gh repo fork --clone"
#: gcr [name] -- create a GitHub repo
alias gcr="gh repo create"

# Search, releases, misc
#: gsp <query> -- search PRs across GitHub
alias gsp="gh search prs"
#: gsi <query> -- search issues across GitHub
alias gsi="gh search issues"
#: gsc <query> -- search code across GitHub
alias gsc="gh search code"
#: grel -- list releases
alias grel="gh release list"
#: grelc <tag> -- create a release
alias grelc="gh release create"
#: gapi <endpoint> -- raw GitHub API call (gh api)
alias gapi="gh api"
#: gauth -- which GitHub accounts gh is logged in as
alias gauth="gh auth status"
#: grv [tag] -- verify a release's attestation
alias grv="gh release verify"
#: gha <verify|download|...> -- gh attestation (artifact provenance)
alias gha="gh attestation"

# Worktree path where a branch is checked out (empty if none), and cd there.
# Shared by _gh_pr_checkout and gco so neither bails with "already checked out".
_git_branch_wt() {
  git worktree list --porcelain | awk -v b="refs/heads/$1" \
    '/^worktree /{p=substr($0,10)} $1=="branch" && $2==b {print p; exit}'
}
_cd_branch_wt() { # _cd_branch_wt <branch> <worktree path>
  if [[ $2 == $PWD ]]; then
    echo "already on $1 here"
  else
    echo "$1 is checked out in $2"
    cd "$2"
  fi
}

# _gh_pr_checkout <pr>: smart PR checkout. If the PR's head branch is already
# checked out in a worktree (or here), cd there instead of failing; otherwise gh
# pr checkout. Takes the same args as `gh pr checkout` (number, URL, or branch).
# Someone else's PR in a trusted tree asks first (see _pr_trust_ok).
_gh_pr_checkout() {
  local branch author wt pick
  pick=$(gh pr view "$1" --json headRefName,author -q '"\(.headRefName)\t\(.author.login)"') || return 1
  branch=${pick%%$'\t'*}
  author=${pick#*$'\t'}
  wt=$(_git_branch_wt "$branch")
  if [[ -n "$wt" ]]; then
    _cd_branch_wt "$branch" "$wt"
    return
  fi
  _pr_trust_ok "$author" "$1" || return 1
  gh pr checkout "$@"
}

# gpo: check out a PR (cd to its worktree if it has one). Bare, the gps picker,
# where enter checks out instead of opening the action menu. With args it is
# _gh_pr_checkout (number, URL or branch).
#: gpo [pr] -- check out a PR, or cd to its worktree; bare, pick one
unalias gpo 2>/dev/null
gpo() {
  local n
  if (( $# )); then _gh_pr_checkout "$@"; return; fi
  n=$(_gh_pr_pick 'PR checkout> ' 'enter: checkout (cd to worktree)') || return
  _gh_pr_checkout $n
}

# _herdr_popup <cmd...>: run a command as a herdr popup (`zsh -ic '_herdr_popup gps'`).
# A popup closes the moment its command exits and cannot cd the pane that opened
# it, so: start in the focused pane's dir (gh needs the repo), and afterwards
# either cd that pane to wherever the command ended up (checkout) or wait for a
# key so output (checks, diff, view) stays readable.
_herdr_popup() {
  [[ -n ${HERDR_ACTIVE_PANE_CWD:-} ]] && cd "$HERDR_ACTIVE_PANE_CWD"
  local start=$PWD
  "$@"
  if [[ $PWD != $start && -n ${HERDR_ACTIVE_PANE_ID:-} && -x ${HERDR_BIN_PATH:-} ]]; then
    "$HERDR_BIN_PATH" pane run "$HERDR_ACTIVE_PANE_ID" "cd ${(q)PWD}" >/dev/null
  else
    read -sk 1 "?[press any key to close] "
  fi
}

# _pr_trust_ok <author> <pr>: personal and ravenflight are trusted by path, so a
# PR checked out there runs with that trust: mise reads its mise.toml (env, hooks,
# tasks) on cd and lefthook runs its lefthook.yml on commit. Someone else's PR
# asks first, default no; review those under ~/projects/untrusted instead.
_pr_trust_ok() {
  local top me
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  case $top in
    "$HOME"/projects/(personal|ravenflight)/* | "$HOME"/worktrees/(personal|ravenflight)/*) ;;
    *) return 0 ;;
  esac
  me=$(_gh_me 2>/dev/null)
  [[ -n $me && $1 == $me ]] && return 0
  print -u2 "#$2 is by ${1:-an unknown author}. Checking it out in this trusted tree lets its"
  print -u2 "mise.toml and lefthook.yml run. Review it under ~/projects/untrusted instead."
  read -q -u0 "?Check it out here anyway? [y/N] " && { echo; return 0 }
  echo
  return 1
}

# gwc [issue] [slug]: start an issue by hand the way Claude does. Makes the
# worktree ~/worktrees/<tier>/<repo>/<N>-<slug> on branch worktree-<N>-<slug>
# with the same worktree-create.sh hook, pushes the branch so gws counts it as
# tracked, and cd's there. Bare, picks an open issue; the slug defaults to the
# issue title.
#: gwc [issue] [slug] -- start an issue in a new pushed worktree and cd there; bare, pick one
unalias gwc 2>/dev/null
gwc() {
  setopt local_options extendedglob
  local n=${1:-} slug=${2:-} hook f dest
  for f in ~/.claude/scripts/worktree-create.sh ~/.dotfiles/.claude/scripts/worktree-create.sh; do
    [[ -x $f ]] && { hook=$f; break }
  done
  [[ -n $hook ]] || { print -u2 "gwc: worktree-create.sh not found (install.sh links it)"; return 1 }
  if [[ -z $n ]]; then
    n=$(gh issue list --limit 100 --json number,title -q '.[] | "\(.number)\t\(.title)"' \
      | fzf --delimiter='\t' --prompt='issue> ' --preview='gh issue view {1}' --preview-window=right,60% \
      | cut -f1) || return 1
  fi
  n=${n#\#}
  [[ $n == <-> ]] || { print -u2 "usage: gwc [issue number] [slug]"; return 2 }
  if [[ -z $slug ]]; then
    slug=$(gh issue view "$n" --json title -q .title) || return 1
  fi
  # lowercase, runs of anything else become one dash, at most 40 chars
  slug=${${(L)slug}//[^a-z0-9]##/-}
  slug=${${slug##-##}[1,40]}
  slug=${slug%%-##}
  dest=$(jq -cn --arg cwd "$PWD" --arg name "$n-$slug" '{cwd: $cwd, name: $name}' | "$hook") || return 1
  cd "$dest" || return 1
  git push -q -u origin HEAD 2>/dev/null || print -u2 "gwc: push failed; gws lists the branch as orphaned until it is pushed"
  echo "on $(git branch --show-current) in ${dest/#$HOME/~}"
}

# gwo: bare, an fzf picker of all worktrees with the gwl columns (local state and
# the branch's PR, colored; preview shows status and recent log) that cd's to the
# pick. With args it is gco (cd to the branch's worktree, else git checkout).
#: gwo [branch] -- cd to a worktree; bare, pick one
unalias gwo 2>/dev/null
gwo() {
  local pick
  if (( $# )); then gco "$@"; return; fi
  pick=$(_gw_rows | fzf --ansi --delimiter=$'\t' --with-nth=3 --prompt='worktree> ' \
    --preview='git -C {1} -c color.status=always status -sb; echo; git -C {1} log --oneline --color=always -8' \
    --preview-window=down,12) || return 1
  _cd_branch_wt "$(cut -f2 <<<"$pick")" "${pick%%$'\t'*}"
}

# gcm: cd to the repo's main checkout (the first entry in git worktree list),
# whatever branch it is on.
#: gcm -- cd to the main checkout
unalias gcm 2>/dev/null
gcm() {
  _cd_branch_wt "main checkout" "$(git worktree list --porcelain | awk 'NR==1{print substr($0,10); exit}')"
}

# gwr: git worktree remove. With args, passes them straight through (so
# `gwr -f path` works). With none, shows an fzf picker of the other worktrees
# (tab multi-selects, preview shows status) and removes what you pick.
#: gwr [path] -- remove worktrees; bare, multi-pick
unalias gwr 2>/dev/null
gwr() {
  local -a picks
  local p
  if (( $# )); then git worktree remove "$@"; return; fi
  picks=("${(@f)$(git worktree list --porcelain \
    | awk '/^worktree /{p=substr($0,10); n++} n>1 && /^branch /{b=substr($0,8); sub(/refs\/heads\//,"",b); print p "\t" b}' \
    | fzf --multi --delimiter='\t' --with-nth=2 --prompt='remove worktree> ' \
        --preview='git -C {1} status -sb' --preview-window=down,6)}")
  [[ -n "${picks[1]}" ]] || return 1
  for p in $picks; do git worktree remove "${p%%$'\t'*}" && echo "removed ${p%%$'\t'*}"; done
}

# fzf pickers: these run their usual command when given args and fall back to an
# fzf picker when called bare (like gwo and gwr). `gh issue` needs a number, so
# bare giv/giw/gie/gic/gicm use the current worktree-<N>-<slug> branch's issue
# N, else (or with -p/--pick) pick an open issue first. Bare gic asks before
# closing the branch's issue unless given -y/--yes. gh already prompts on
# its own for `gh run view/cancel/download/rerun` and `gh workflow run`.
# (gid, `gh issue develop`, is gone: gwc starts an issue in a worktree instead.)
unalias giv giw gie gic gicm gid gco 2>/dev/null
_gi() { # _gi "<gh issue subcommand + flags>" [args...]
  local sub=$1 n; shift
  if [[ ${1:-} == (-p|--pick) ]]; then
    shift
  elif (( $# )); then
    gh issue ${=sub} "$@"; return
  elif n=$(_gh_branch_issue); then
    gh issue ${=sub} $n; return
  fi
  n=$(gh issue list --limit 100 --json number,title -q '.[] | "\(.number)\t\(.title)"' \
    | fzf --delimiter='\t' --prompt='issue> ' --preview='gh issue view {1}' --preview-window=right,60% \
    | cut -f1) || return 1
  [[ -n "$n" ]] || return 1
  gh issue ${=sub} "$n"
}
#: giv [issue] -- view an issue; bare, this branch's issue, else pick one
giv() { _gi view "$@" }
#: giw [issue] -- open an issue in the browser; bare, this branch's issue, else pick one
giw() { _gi "view --web" "$@" }
#: gie [issue] -- edit an issue; bare, this branch's issue, else pick one
gie() { _gi edit "$@" }
#: gic [issue] -- close an issue; bare, this branch's issue (confirms), else pick one
gic() {
  local a n yes=0
  local -a args
  for a in "$@"; do
    case $a in -y|--yes) yes=1 ;; *) args+=("$a") ;; esac
  done
  if (( ! $#args )) && n=$(_gh_branch_issue); then
    (( yes )) || _confirm "Close #$n (this branch's issue)?" || return 1
    gh issue close $n; return
  fi
  _gi close "${args[@]}"
}
#: gicm [issue] -- comment on an issue; bare, this branch's issue, else pick one
gicm() { _gi comment "$@" }
unfunction gid 2>/dev/null
# gco: bare, pick a local branch (most recent first, preview shows its log).
# A single branch name (picked or typed) that is checked out in another worktree
# cd's there instead of failing; anything else is plain `git checkout`.
#: gco [branch] -- check out a branch, or cd to its worktree; bare, pick one
gco() {
  local b wt
  if (( $# )); then
    b=$1
    if (( $# == 1 )) && [[ $b != -* ]] && git show-ref -q --verify "refs/heads/$b" \
        && wt=$(_git_branch_wt "$b") && [[ -n $wt ]]; then
      _cd_branch_wt "$b" "$wt"
      return
    fi
    git checkout "$@"
    return
  fi
  b=$(git branch --sort=-committerdate --format='%(refname:short)' \
    | fzf --prompt='checkout> ' --preview='git log --oneline --color=always -10 {}') || return 1
  gco "$b"
}

# gwl: scannable worktree overview, like `git status` for all worktrees: path,
# branch, local state (dirty files, ahead/behind upstream, locked) and the
# branch's PR (checks, review, merge state; merged/closed shown plainly, with a
# warning when the branch has commits newer than the merged PR). With other args it
# is plain `git worktree list`. `*` marks the worktree you are in. PR data is cached
# (see _gw_prs); -r refreshes it first.
#: gwl [-r] -- every worktree with local state and its PR's status (-r: refresh PRs)
unalias gwl 2>/dev/null
gwl() {
  local -a opt
  [[ ${1:-} == -r ]] && { opt=(-r); shift }
  if (( $# )); then git worktree list "$@"; return; fi
  _gw_rows $opt | cut -f3-
}

# _gw_fetch_prs <cache file>: fetch the repo's PRs and write them to the cache file
# atomically; on any failure the old cache is left alone. Two parallel `gh` calls:
# open PRs with every field, and merged/closed ones with only what the rows need
# (the check rollup of 100 old PRs is most of the payload).
_gw_fetch_prs() {
  setopt local_options no_monitor no_notify no_bg_nice
  local f=$1 t p1 p2 s1 s2 oldumask
  t=$(mktemp "$f.XXXXXX") || return 1
  # the sidecars hold authenticated PR JSON: create them private
  oldumask=$(umask); umask 077
  gh pr list --state open --limit 100 --json "$_gh_pr_fields,state,headRefOid" >|$t.open 2>/dev/null &
  p1=$!
  gh pr list --state closed --limit 100 --json number,headRefName,headRefOid,state >|$t.all 2>/dev/null &
  p2=$!
  wait $p1; s1=$?
  wait $p2; s2=$?
  if (( ! s1 && ! s2 )) && jq -s '.[0] + (.[1] | map(select(.state != "OPEN")))' $t.open $t.all >|$t 2>/dev/null; then
    mv -f $t $f
  else
    rm -f $t
  fi
  rm -f $t.open $t.all
  umask $oldumask
}

# _gw_prs [-r]: the repo's PR JSON for _gw_rows, cached per repo in
# ~/.cache/zsh/gwl-<key>.json. Younger than $GWL_TTL seconds (default 60) it is used
# as is; older it is still printed at once and refreshed in the background (so the
# next run is current); missing, or with -r, it is fetched first.
_gw_prs() {
  zmodload -F zsh/stat b:zstat 2>/dev/null; zmodload zsh/datetime 2>/dev/null
  local d=${XDG_CACHE_HOME:-$HOME/.cache}/zsh key f lock
  local -a m
  key=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || { print '[]'; return }
  key=$(print -rn -- $key | cksum); f=$d/gwl-${key%% *}.json; lock=$f.lock
  mkdir -p $d 2>/dev/null
  if [[ ${1:-} != -r && -s $f ]]; then
    cat $f
    zstat -A m +mtime $f
    if (( EPOCHSECONDS - m[1] >= ${GWL_TTL:-60} )); then
      # one refresher at a time; a lock older than 2 minutes is a killed one
      if zstat -A m +mtime $lock 2>/dev/null && (( EPOCHSECONDS - m[1] > 120 )); then rmdir $lock 2>/dev/null; fi
      if mkdir $lock 2>/dev/null; then
        { _gw_fetch_prs $f; rmdir $lock 2>/dev/null } >/dev/null 2>&1 &!
      fi
    fi
    return
  fi
  _gw_fetch_prs $f
  if [[ -s $f ]]; then cat $f; else print '[]'; fi
}

# _gw_rows [-r]: one line per worktree, "<path>\t<branch>\t<aligned gwl row>" (gwl, gwo).
# The per-worktree git status runs in parallel, overlapping the PR lookup.
_gw_rows() {
  setopt local_options no_monitor no_notify no_bg_nice
  local prs='[]' p h b lk o st t cur w1=0 w2=0 i tmp have_gh=0 pr
  local dim=$'\e[2m' red=$'\e[31m' yel=$'\e[33m' rst=$'\e[0m'
  local -A prtxt proid prstate
  local -a raw paths branches heads fheads locals prcols locks pids loc st_
  tmp=$(mktemp -d) || return 1
  cur=$(git rev-parse --show-toplevel 2>/dev/null)
  while IFS=$'\t' read -r p h b lk; do
    raw+=("$p"); paths+=("${p/#$HOME/~}"); branches+=("$b"); heads+=("${h[1,7]}"); fheads+=("$h"); locks+=("$lk")
    [[ $p == $cur ]] && paths[-1]="* ${paths[-1]}" || paths[-1]="  ${paths[-1]}"
    (( ${#paths[-1]} > w1 )) && w1=${#paths[-1]}
    (( ${#b} > w2 )) && w2=${#b}
    # "<dirty> <ahead> <behind> <has upstream>"; no-optional-locks so parallel runs and
    # background refreshes never fight over the index
    git --no-optional-locks -C "$p" status --porcelain=v2 --branch 2>/dev/null | awk '
      /^# branch.ab/ { a = substr($3, 2); bh = substr($4, 2); up = 1 }
      !/^#/          { d++ }
      END            { print d + 0, a + 0, bh + 0, up + 0 }' >|$tmp/${#raw} &
    pids+=($!)
  done < <(git worktree list --porcelain | awk '
    function flush() { if (path != "") printf "%s\t%s\t%s\t%s\n", path, head, (branch == "" ? "(detached)" : branch), (locked ? "locked" : "-"); path = branch = head = ""; locked = 0 }
    /^worktree / { flush(); path = substr($0, 10) }
    /^HEAD /     { head = substr($0, 6) }
    /^branch /   { branch = substr($0, 8); sub(/^refs\/heads\//, "", branch) }
    /^locked/    { locked = 1 }
    END          { flush() }')
  if (( $+commands[gh] || $+functions[gh] )); then
    have_gh=1
    prs=$(_gw_prs "$@")
  fi
  (( ${#pids} )) && wait $pids 2>/dev/null
  while IFS=$'\t' read -r b o st t; do
    prtxt[$b]=$t; proid[$b]=$o; prstate[$b]=$st
  done < <(jq -r --arg me "" "$_gh_pr_jq_defs"'
    group_by(.headRefName)[] | (map(select(.state == "OPEN")) + sort_by(-.number)) | .[0]
    | "\(.headRefName)\t\(.headRefOid)\t\(.state)\t\(pr_summary)"' <<<"$prs" 2>/dev/null)
  for (( i = 1; i <= ${#raw}; i++ )); do
    b=${branches[i]}; h=${fheads[i]}
    st_=(${=$(<$tmp/$i)}); loc=()
    (( st_[1] )) && loc+=("${yel}${st_[1]} dirty${rst}")
    if (( st_[4] )); then
      (( st_[2] )) && loc+=("ahead ${st_[2]}")
      (( st_[3] )) && loc+=("${yel}behind ${st_[3]}${rst}")
    elif [[ $b != "(detached)" ]]; then
      loc+=("${dim}no upstream${rst}")
    fi
    [[ ${locks[i]} == locked ]] && loc+=("locked")
    (( ${#loc} )) || loc=("${dim}clean${rst}")
    pr=""
    if [[ -n ${prtxt[$b]:-} ]]; then
      pr=${prtxt[$b]}
      [[ ${prstate[$b]} != OPEN && ${proid[$b]} != $h ]] && pr+=" ${red}(new commits since)${rst}"
    elif (( have_gh )); then
      pr="${dim}no PR${rst}"
    fi
    locals+=("${(j: :)loc}"); prcols+=("$pr")
  done
  rm -rf $tmp
  for (( i = 1; i <= ${#raw}; i++ )); do
    printf '%s\t%s\t%-*s  %-*s  %s  %s%s\n' "${raw[i]}" "${branches[i]}" $w1 "${paths[i]}" $w2 "${branches[i]}" "${heads[i]}" "${locals[i]}" "${prcols[i]:+  ${prcols[i]}}"
  done
}

# dx <group>... -- <cmd...>: run cmd with secrets from Dashlane injected into
# its environment only. Each group is ~/.config/dashlane/<group>.env, a list of
# NAME=dl://<entry title>/password references (not secrets).
dx() {
  local -a groups
  local g f
  (( $+commands[dcli] )) || { print -u2 "dx: dcli (Dashlane CLI) is not installed"; return 127 }
  while (( $# )) && [[ $1 != -- ]]; do groups+=("$1"); shift; done
  [[ $1 == -- ]] && shift
  if (( ! $# || ! ${#groups} )); then
    print -u2 "usage: dx <group>... -- <cmd...>  (groups: $(ls ~/.config/dashlane 2>/dev/null | sed 's/\.env$//' | tr '\n' ' '))"
    return 2
  fi
  (
    for g in $groups; do
      f=~/.config/dashlane/$g.env
      [[ -r $f ]] || { print -u2 "dx: no such group: $g"; exit 1 }
      set -a; source $f; set +a
    done
    # dcli exec re-joins its args into a shell string, so pass one pre-quoted string
    dcli exec -- "${(j: :)${(q)@}}"
  )
}
