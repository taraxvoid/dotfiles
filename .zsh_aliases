# github CLI
alias grem="git remote -v"
# One table of every open PR (mine, review requests, bots like dependabot/release-please)
# with CI checks, review decision, and merge state. Extra args pass through to `gh pr list`.
unalias gps 2>/dev/null
gps() {
  local me; me=$(gh api user --jq .login) || return
  gh pr list --limit 100 "$@" --json number,title,author,headRefName,isDraft,reviewDecision,mergeable,statusCheckRollup,reviewRequests \
  | jq -r --arg me "$me" '
    def c(code; s): "\u001b[\(code)m\(s)\u001b[0m";
    def checks:
      (.statusCheckRollup // []) as $r
      | if ($r | length) == 0 then c("2"; "no checks")
        elif any($r[]; (.conclusion // .state // "") | IN("FAILURE","ERROR","TIMED_OUT","CANCELLED","ACTION_REQUIRED")) then c("31"; "checks failing")
        elif any($r[]; (.status // "COMPLETED") != "COMPLETED" or (.state // "") == "PENDING") then c("33"; "checks pending")
        else c("32"; "checks passing") end;
    def review:
      if .isDraft then c("2"; "draft")
      elif .reviewDecision == "APPROVED" then c("32"; "approved")
      elif .reviewDecision == "CHANGES_REQUESTED" then c("31"; "changes requested")
      elif .reviewDecision == "REVIEW_REQUIRED" then c("33"; "review required")
      else c("2"; "no review") end;
    def merge:
      if .mergeable == "CONFLICTING" then c("31"; "conflicts")
      elif .mergeable == "MERGEABLE" then c("32"; "mergeable")
      else c("2"; "merge unknown") end;
    if length == 0 then "No open PRs" else
    sort_by([(.author.login != $me), .number])[]
    | "\(c("1;32"; "#\(.number)")) \(.title)  \(c("36"; .headRefName))\n    \(if .author.login == $me then c("35"; "you") else .author.login end) | \(checks) | \(review) | \(merge)\(if any(.reviewRequests[]?; .login == $me) then " | " + c("35"; "review requested") else "" end)"
    end'
}
alias ga="git add ."
alias gci="git commit"
alias grl="gh run list"
_gh_rerun_failed_branch() {
  local branch run_id
  branch=$(git branch --show-current)
  if [[ -z "$branch" ]]; then
    print -u2 -- "not on a branch"
    return 1
  fi
  run_id=$(gh run list --branch "$branch" --status failure --limit 1 --json databaseId --jq '.[0].databaseId')
  if [[ -z "$run_id" ]]; then
    print -u2 -- "no failed runs found for branch $branch"
    return 1
  fi
  gh run rerun --failed "$run_id"
}
alias grf=_gh_rerun_failed_branch

alias gpm="gh pr merge --squash"
alias gpd="gh pr diff"
alias gpl="gh pr list"
alias gil="gh issue list"
alias gco="git checkout"
alias gf="git fetch --all --tags"

# gh pr checks --watch, but bails on first failure so you don't sit there
# after the outcome is already decided.
alias gpc="gh pr checks"

# Resolve the databaseId of a PR's most recent run (current branch, or pass
# a PR number/branch). 
_gh_pr_run_id() {
  local ref="${1:-}"
  if [[ -n "$ref" ]]; then
    ref=$(gh pr view "$ref" --json headRefName -q .headRefName) || return 1
  else
    ref=$(git branch --show-current)
  fi
  gh run list --branch "$ref" --limit 1 --json databaseId -q '.[0].databaseId'
}

# Stream live job output for a PR's most recent run (current branch, or pass
# a PR number/branch). Unlike `gpc` (which polls check *status*), this tails
# the actual log via `gh run watch`. If the run already finished, `gh run
# watch` just prints a one-liner, so fall back to the full annotated summary
# (catches things like workflow-syntax failures that never produced jobs).
grw() {
  local ref="${1:-}" run_id run_status
  run_id=$(_gh_pr_run_id "$ref") || return 1
  if [[ -z "$run_id" ]]; then
    echo "no runs found for branch ${ref:-$(git branch --show-current)}" >&2
    return 1
  fi
  run_status=$(gh run view "$run_id" --json status -q .status)
  if [[ "$run_status" == "completed" ]]; then
    gh run view "$run_id"
  else
    gh run watch "$run_id" --exit-status
  fi
}

# Jump straight to the failed-step logs for a PR's most recent run (current
# branch, or pass a PR number/branch) — no manual `gh run list` + id lookup.
# Falls back to the annotated run summary when there's no log to fetch (e.g.
# the run succeeded, so --log-failed has nothing to print, or it failed
# before any job ran, like a workflow-syntax error).
gj() {
  local ref="${1:-}" run_id conclusion
  run_id=$(_gh_pr_run_id "$ref") || return 1
  if [[ -z "$run_id" ]]; then
    echo "no runs found for branch ${ref:-$(git branch --show-current)}" >&2
    return 1
  fi
  conclusion=$(gh run view "$run_id" --json conclusion -q .conclusion)
  if [[ "$conclusion" != "failure" ]]; then
    gh run view "$run_id"
    return
  fi
  local out
  out=$(gh run view "$run_id" --log-failed 2>/dev/null)
  if [[ -n "$out" ]]; then
    print -r -- "$out"
  else
    gh run view "$run_id"
  fi
}


