# Worktree path where a branch is checked out (empty if none), and cd there.
# Shared by _gh_pr_checkout and gco so neither bails with "already checked out".
_git_branch_wt() {
  git worktree list --porcelain | awk -v b="refs/heads/$1" \
    '/^worktree /{p=substr($0,10)} $1=="branch" && $2==b {print p; exit}'
}
_cd_branch_wt() { # _cd_branch_wt <branch> <worktree path>
  if [[ $2 == $PWD ]]; then
    echo "already on $1 here"
  else
    echo "$1 is checked out in $2"
    cd "$2"
  fi
}

# _gh_pr_checkout <pr>: smart PR checkout. If the PR's head branch is already
# checked out in a worktree (or here), cd there instead of failing; otherwise gh
# pr checkout. Takes the same args as `gh pr checkout` (number, URL, or branch).
# Someone else's PR in a trusted tree asks first (see _pr_trust_ok).
_gh_pr_checkout() {
  local branch author wt pick
  pick=$(gh pr view "$1" --json headRefName,author -q '"\(.headRefName)\t\(.author.login)"') || return 1
  branch=${pick%%$'\t'*}
  author=${pick#*$'\t'}
  wt=$(_git_branch_wt "$branch")
  if [[ -n "$wt" ]]; then
    _cd_branch_wt "$branch" "$wt"
    return
  fi
  _pr_trust_ok "$author" "$1" || return 1
  gh pr checkout "$@"
}

# gpo: check out a PR (cd to its worktree if it has one). Bare, the gps picker,
# where enter checks out instead of opening the action menu. With args it is
# _gh_pr_checkout (number, URL or branch).
unalias gpo 2>/dev/null
gpo() {
  local n
  if (( $# )); then _gh_pr_checkout "$@"; return; fi
  n=$(_gh_pr_pick 'PR checkout> ' 'enter: checkout (cd to worktree)') || return
  _gh_pr_checkout $n
}

# _pr_trust_ok <author> <pr>: personal and ravenflight are trusted by path, so a
# PR checked out there runs with that trust: mise reads its mise.toml (env, hooks,
# tasks) on cd and lefthook runs its lefthook.yml on commit. Someone else's PR
# asks first, default no; review those under ~/projects/untrusted instead.
_pr_trust_ok() {
  local top me
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  case $top in
    "$HOME"/projects/(personal|ravenflight)/* | "$HOME"/worktrees/(personal|ravenflight)/*) ;;
    *) return 0 ;;
  esac
  me=$(_gh_me 2>/dev/null)
  [[ -n $me && $1 == $me ]] && return 0
  print -u2 "#$2 is by ${1:-an unknown author}. Checking it out in this trusted tree lets its"
  print -u2 "mise.toml and lefthook.yml run. Review it under ~/projects/untrusted instead."
  read -q "?Check it out here anyway? [y/N] " && { echo; return 0 }
  echo
  return 1
}

# gwc [issue] [slug]: start an issue by hand the way Claude does. Makes the
# worktree ~/worktrees/<tier>/<repo>/<N>-<slug> on branch worktree-<N>-<slug>
# with the same worktree-create.sh hook, pushes the branch so gws counts it as
# tracked, and cd's there. Bare, picks an open issue; the slug defaults to the
# issue title.
unalias gwc 2>/dev/null
gwc() {
  setopt local_options extendedglob
  local n=${1:-} slug=${2:-} hook f dest
  for f in ~/.claude/scripts/worktree-create.sh ~/.dotfiles/.claude/scripts/worktree-create.sh; do
    [[ -x $f ]] && { hook=$f; break }
  done
  [[ -n $hook ]] || { print -u2 "gwc: worktree-create.sh not found (install.sh links it)"; return 1 }
  if [[ -z $n ]]; then
    n=$(gh issue list --limit 100 --json number,title -q '.[] | "\(.number)\t\(.title)"' \
      | fzf --delimiter='\t' --prompt='issue> ' --preview='gh issue view {1}' --preview-window=right,60% \
      | cut -f1) || return 1
  fi
  n=${n#\#}
  [[ $n == <-> ]] || { print -u2 "usage: gwc [issue number] [slug]"; return 2 }
  if [[ -z $slug ]]; then
    slug=$(gh issue view "$n" --json title -q .title) || return 1
  fi
  # lowercase, runs of anything else become one dash, at most 40 chars
  slug=${${(L)slug}//[^a-z0-9]##/-}
  slug=${${slug##-##}[1,40]}
  slug=${slug%%-##}
  dest=$(jq -cn --arg cwd "$PWD" --arg name "$n-$slug" '{cwd: $cwd, name: $name}' | "$hook") || return 1
  cd "$dest" || return 1
  git push -q -u origin HEAD 2>/dev/null || print -u2 "gwc: push failed; gws lists the branch as orphaned until it is pushed"
  echo "on $(git branch --show-current) in ${dest/#$HOME/~}"
}

# gwo: bare, an fzf picker of all worktrees with the gwl columns (local state and
# the branch's PR, colored; preview shows status and recent log) that cd's to the
# pick. With args it is gco (cd to the branch's worktree, else git checkout).
unalias gwo 2>/dev/null
gwo() {
  local pick
  if (( $# )); then gco "$@"; return; fi
  pick=$(_gw_rows | fzf --ansi --delimiter=$'\t' --with-nth=3 --prompt='worktree> ' \
    --preview='git -C {1} -c color.status=always status -sb; echo; git -C {1} log --oneline --color=always -8' \
    --preview-window=down,12) || return 1
  _cd_branch_wt "$(cut -f2 <<<"$pick")" "${pick%%$'\t'*}"
}

# gcm: cd to the repo's main checkout (the first entry in git worktree list),
# whatever branch it is on.
unalias gcm 2>/dev/null
gcm() {
  _cd_branch_wt "main checkout" "$(git worktree list --porcelain | awk 'NR==1{print substr($0,10); exit}')"
}

# gwr: git worktree remove. With args, passes them straight through (so
# `gwr -f path` works). With none, shows an fzf picker of the other worktrees
# (tab multi-selects, preview shows status) and removes what you pick.
unalias gwr 2>/dev/null
gwr() {
  local -a picks
  local p
  if (( $# )); then git worktree remove "$@"; return; fi
  picks=("${(@f)$(git worktree list --porcelain \
    | awk '/^worktree /{p=substr($0,10); n++} n>1 && /^branch /{b=substr($0,8); sub(/refs\/heads\//,"",b); print p "\t" b}' \
    | fzf --multi --delimiter='\t' --with-nth=2 --prompt='remove worktree> ' \
        --preview='git -C {1} status -sb' --preview-window=down,6)}")
  [[ -n "${picks[1]}" ]] || return 1
  for p in $picks; do git worktree remove "${p%%$'\t'*}" && echo "removed ${p%%$'\t'*}"; done
}

# fzf pickers: these run their usual command when given args and fall back to an
# fzf picker when called bare (like gwo and gwr). `gh issue` needs a number, so
# bare giv/giw/gie/gic/gicm pick an open issue first. gh already prompts on
# its own for `gh run view/cancel/download/rerun` and `gh workflow run`.
# (gid, `gh issue develop`, is gone: gwc starts an issue in a worktree instead.)
unalias giv giw gie gic gicm gid gco 2>/dev/null
_gi() { # _gi "<gh issue subcommand + flags>" [args...]
  local sub=$1 n; shift
  if (( $# )); then gh issue ${=sub} "$@"; return; fi
  n=$(gh issue list --limit 100 --json number,title -q '.[] | "\(.number)\t\(.title)"' \
    | fzf --delimiter='\t' --prompt='issue> ' --preview='gh issue view {1}' --preview-window=right,60% \
    | cut -f1) || return 1
  [[ -n "$n" ]] || return 1
  gh issue ${=sub} "$n"
}
giv() { _gi view "$@" }
giw() { _gi "view --web" "$@" }
gie() { _gi edit "$@" }
gic() { _gi close "$@" }
gicm() { _gi comment "$@" }
unfunction gid 2>/dev/null
# gco: bare, pick a local branch (most recent first, preview shows its log).
# A single branch name (picked or typed) that is checked out in another worktree
# cd's there instead of failing; anything else is plain `git checkout`.
gco() {
  local b wt
  if (( $# )); then
    b=$1
    if (( $# == 1 )) && [[ $b != -* ]] && git show-ref -q --verify "refs/heads/$b" \
        && wt=$(_git_branch_wt "$b") && [[ -n $wt ]]; then
      _cd_branch_wt "$b" "$wt"
      return
    fi
    git checkout "$@"
    return
  fi
  b=$(git branch --sort=-committerdate --format='%(refname:short)' \
    | fzf --prompt='checkout> ' --preview='git log --oneline --color=always -10 {}') || return 1
  gco "$b"
}

# gwl: scannable worktree overview, like `git status` for all worktrees: path,
# branch, local state (dirty files, ahead/behind upstream, locked) and the
# branch's PR (checks, review, merge state; merged/closed shown plainly, with a
# warning when the branch has commits newer than the merged PR). With args it is
# plain `git worktree list`. `*` marks the worktree you are in.
unalias gwl 2>/dev/null
gwl() {
  if (( $# )); then git worktree list "$@"; return; fi
  _gw_rows | cut -f3-
}

# _gw_rows: one line per worktree, "<path>\t<branch>\t<aligned gwl row>" (gwl, gwo).
_gw_rows() {
  local prs='[]' p h b lk o st t dirty lr pr loc cur w1=0 w2=0 i
  local dim=$'\e[2m' red=$'\e[31m' yel=$'\e[33m' rst=$'\e[0m'
  local -A prtxt proid prstate
  local -a raw paths branches heads locals prcols
  if (( $+commands[gh] )); then
    prs=$(gh pr list --state all --limit 100 --json "$_gh_pr_fields,state,headRefOid" 2>/dev/null) || prs='[]'
  fi
  while IFS=$'\t' read -r b o st t; do
    prtxt[$b]=$t; proid[$b]=$o; prstate[$b]=$st
  done < <(jq -r --arg me "" "$_gh_pr_jq_defs"'
    group_by(.headRefName)[] | (map(select(.state == "OPEN")) + sort_by(-.number)) | .[0]
    | "\(.headRefName)\t\(.headRefOid)\t\(.state)\t\(pr_summary)"' <<<"$prs" 2>/dev/null)
  cur=$(git rev-parse --show-toplevel 2>/dev/null)
  while IFS=$'\t' read -r p h b lk; do
    dirty=$(git -C "$p" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    loc=()
    (( dirty )) && loc+=("${yel}${dirty} dirty${rst}")
    if lr=$(git -C "$p" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null); then
      (( ${lr##*[[:space:]]} )) && loc+=("ahead ${lr##*[[:space:]]}")
      (( ${lr%%[[:space:]]*} )) && loc+=("${yel}behind ${lr%%[[:space:]]*}${rst}")
    elif [[ $b != "(detached)" ]]; then
      loc+=("${dim}no upstream${rst}")
    fi
    [[ $lk == locked ]] && loc+=("locked")
    (( ${#loc} )) || loc=("${dim}clean${rst}")
    pr=""
    if (( ${#paths} )) && [[ -n ${prtxt[$b]:-} ]]; then
      pr=${prtxt[$b]}
      [[ ${prstate[$b]} != OPEN && ${proid[$b]} != $h ]] && pr+=" ${red}(new commits since)${rst}"
    elif (( ${#paths} )); then
      pr="${dim}no PR${rst}"
    fi
    raw+=("$p"); paths+=("${p/#$HOME/~}"); branches+=("$b"); heads+=("${h[1,7]}")
    locals+=("${(j: :)loc}"); prcols+=("$pr")
    [[ $p == $cur ]] && paths[-1]="* ${paths[-1]}" || paths[-1]="  ${paths[-1]}"
    (( ${#paths[-1]} > w1 )) && w1=${#paths[-1]}
    (( ${#b} > w2 )) && w2=${#b}
  done < <(git worktree list --porcelain | awk '
    function flush() { if (path != "") printf "%s\t%s\t%s\t%s\n", path, head, (branch == "" ? "(detached)" : branch), (locked ? "locked" : "-"); path = branch = head = ""; locked = 0 }
    /^worktree / { flush(); path = substr($0, 10) }
    /^HEAD /     { head = substr($0, 6) }
    /^branch /   { branch = substr($0, 8); sub(/^refs\/heads\//, "", branch) }
    /^locked/    { locked = 1 }
    END          { flush() }')
  for (( i = 1; i <= ${#paths}; i++ )); do
    printf '%s\t%s\t%-*s  %-*s  %s  %s%s\n' "${raw[i]}" "${branches[i]}" $w1 "${paths[i]}" $w2 "${branches[i]}" "${heads[i]}" "${locals[i]}" "${prcols[i]:+  ${prcols[i]}}"
  done
}

# dx <group>... -- <cmd...>: run cmd with secrets from Dashlane injected into
# its environment only. Each group is ~/.config/dashlane/<group>.env, a list of
# NAME=dl://<entry title>/password references (not secrets).
dx() {
  local -a groups
  local g f
  (( $+commands[dcli] )) || { print -u2 "dx: dcli (Dashlane CLI) is not installed"; return 127 }
  while (( $# )) && [[ $1 != -- ]]; do groups+=("$1"); shift; done
  [[ $1 == -- ]] && shift
  if (( ! $# || ! ${#groups} )); then
    print -u2 "usage: dx <group>... -- <cmd...>  (groups: $(ls ~/.config/dashlane 2>/dev/null | sed 's/\.env$//' | tr '\n' ' '))"
    return 2
  fi
  (
    for g in $groups; do
      f=~/.config/dashlane/$g.env
      [[ -r $f ]] || { print -u2 "dx: no such group: $g"; exit 1 }
      set -a; source $f; set +a
    done
    # dcli exec re-joins its args into a shell string, so pass one pre-quoted string
    dcli exec -- "${(j: :)${(q)@}}"
  )
}
