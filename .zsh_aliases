# gh pr checks --watch, but bails on first failure so you don't sit there
# after the outcome is already decided.
alias gpc="gh pr checks --watch --fail-fast"

# Resolve the databaseId of a PR's most recent run (current branch, or pass
# a PR number/branch). 
_gh_pr_run_id() {
  local ref="${1:-}"
  if [[ -n "$ref" ]]; then
    ref=$(gh pr view "$ref" --json headRefName -q .headRefName) || return 1
  else
    ref=$(git branch --show-current)
  fi
  gh run list --branch "$ref" --limit 1 --json databaseId -q '.[0].databaseId'
}

# Stream live job output for a PR's most recent run (current branch, or pass
# a PR number/branch). Unlike `gpc` (which polls check *status*), this tails
# the actual log via `gh run watch`. If the run already finished, `gh run
# watch` just prints a one-liner, so fall back to the full annotated summary
# (catches things like workflow-syntax failures that never produced jobs).
grw() {
  local ref="${1:-}" run_id run_status
  run_id=$(_gh_pr_run_id "$ref") || return 1
  if [[ -z "$run_id" ]]; then
    echo "no runs found for branch ${ref:-$(git branch --show-current)}" >&2
    return 1
  fi
  run_status=$(gh run view "$run_id" --json status -q .status)
  if [[ "$run_status" == "completed" ]]; then
    gh run view "$run_id"
  else
    gh run watch "$run_id" --exit-status
  fi
}

# Jump straight to the failed-step logs for a PR's most recent run (current
# branch, or pass a PR number/branch) — no manual `gh run list` + id lookup.
# Falls back to the annotated run summary when there's no log to fetch (e.g.
# the run succeeded, so --log-failed has nothing to print, or it failed
# before any job ran, like a workflow-syntax error).
gj() {
  local ref="${1:-}" run_id conclusion
  run_id=$(_gh_pr_run_id "$ref") || return 1
  if [[ -z "$run_id" ]]; then
    echo "no runs found for branch ${ref:-$(git branch --show-current)}" >&2
    return 1
  fi
  conclusion=$(gh run view "$run_id" --json conclusion -q .conclusion)
  if [[ "$conclusion" != "failure" ]]; then
    gh run view "$run_id"
    return
  fi
  local out
  out=$(gh run view "$run_id" --log-failed 2>/dev/null)
  if [[ -n "$out" ]]; then
    print -r -- "$out"
  else
    gh run view "$run_id"
  fi
}


