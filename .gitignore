# only the ssh config is tracked; keys, known_hosts and config.local stay local
.ssh/*
!.ssh/config
.claude/
# generated by zsh compinit and antidote (from .zsh_plugins.txt)
.zcompdump*
.zsh_plugins.zsh
# yazi plugins: `ya pkg install` fetches them at the revs in package.toml
.config/yazi/plugins/
# Clawness: per-machine session state (memory.md and rules/ stay shared)
.clawness/*
!.clawness/memory.md
!.clawness/rules/
