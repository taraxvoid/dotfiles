# Dashlane references (not secrets). Load with: dx flock -- just <recipe>
# Replaces the plaintext secret lines in ~/projects/flock/.env (keep
# SOPS_AGE_KEY_FILE there; it is only a path).
VULTR_API_KEY=dl://VULTR_API_KEY/password
# enable once the rotated OAuth client secret is in Dashlane:
# TAILSCALE_OAUTH_CLIENT_SECRET=dl://TAILSCALE_OAUTH_CLIENT_SECRET/password
