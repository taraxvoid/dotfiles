{
  "version": 1,
  "permissions": {
    "allow": [
      "Exec(fd)",
      "Exec(rg)",
      "Exec(jq)",
      "Exec(git remote)",
      "Exec(git fetch)",
      "Fetch(domain:github.com)",
      "Fetch(domain:docs.github.com)",
      "Fetch(domain:docs.npmjs.com)",
      "Fetch(domain:www.npmjs.com)",
      "Fetch(domain:docs.sentry.io)",
      "Fetch(domain:posthog.com)",
      "Fetch(domain:us.posthog.com)",
      "Fetch(https://*.github.com/*)",
      "Fetch(https://*.githubusercontent.com/*)",
      "Fetch(domain:registry.npmjs.org)",
      "Fetch(domain:pypi.org)",
      "Fetch(domain:files.pythonhosted.org)",
      "Fetch(domain:registry.terraform.io)",
      "Fetch(domain:releases.hashicorp.com)",
      "Fetch(domain:developer.hashicorp.com)",
      "Fetch(domain:registry.opentofu.org)",
      "Fetch(domain:developers.cloudflare.com)",
      "Fetch(domain:docs.claude.com)",
      "Fetch(domain:docs.anthropic.com)",
      "Fetch(domain:bun.sh)",
      "Fetch(domain:docs.astral.sh)",
      "Fetch(domain:developer.mozilla.org)",
      "Fetch(domain:doc.rust-lang.org)",
      "Fetch(domain:static.crates.io)",
      "Fetch(domain:index.crates.io)",
      "Fetch(domain:proxy.golang.org)",
      "Fetch(domain:devin.ai)",
      "Fetch(https://*.devin.ai/*)",
      "Fetch(domain:sum.golang.org)",
      "Fetch(domain:go.dev)",
      "Fetch(domain:dl.google.com)",
      "Fetch(domain:github.dev)",
      "Fetch(domain:ghcr.io)",
      "Fetch(https://*.npmjs.org/*)",
      "Fetch(domain:crates.io)",
      "Fetch(https://*.pythonhosted.org/*)",
      "Fetch(https://*.posthog.com/*)",
      "Exec(bun run build)",
      "Exec(git status)",
      "Exec(ls)",
      "Exec(gh api repos/*)",
      "Exec(gh api /repos/*)",
      "Exec(gh api user)",
      "Exec(gh api rate_limit)",
      "Exec(gh aw compile --strict*)",
      "Write(~/.cache/uv/**)",
      "Write(~/.bun/install/cache/**)",
      "Write(~/.local/share/mise/**)",
      "Write(~/.claude/plans/**)",
      "Write(~/Library/Preferences/.wrangler/**)",
      "Write(~/Library/pnpm/**)",
      "Write(~/Library/Caches/pnpm/**)",
      "Write(~/.local/state/pnpm/**)",
      "Write(~/.cache/aube/**)",
      "Write(~/.local/share/aube/**)",
      "Write(~/Library/Caches/aube/**)",
      "Write(~/worktrees/**)",
      "Exec(cat)",
      "Fetch(domain:docs.devin.ai)",
      "Exec(git worktree)",
      "Exec(gh extension)",
      "Exec(git log)"
    ],
    "deny": [
      "Exec(git worktree remove*)",
      "Exec(git worktree prune*)",
      "Exec(git * worktree remove*)",
      "Exec(git * worktree prune*)",
      "Exec(rm -rf ~/worktrees*)",
      "Exec(gh repo delete *)",
      "Exec(gh release delete *)",
      "Exec(gh auth token*)",
      "Exec(gh api *DELETE*)",
      "Exec(gh api * --method*)",
      "Exec(gh api * -X*)",
      "Exec(gh api * --input*)",
      "Exec(gh api repos/* -f*)",
      "Exec(gh api repos/* -F*)",
      "Exec(gh api repos/* --field*)",
      "Exec(gh api repos/* --raw-field*)",
      "Exec(gh api /repos/* -f*)",
      "Exec(gh api /repos/* -F*)",
      "Exec(gh api /repos/* --field*)",
      "Exec(gh api /repos/* --raw-field*)",
      "Exec(git push --force*)",
      "Exec(git push -f*)",
      "Exec(git push * --force*)",
      "Exec(git push * -f*)",
      "Exec(git push * +*)",
      "Exec(git push * main)",
      "Exec(git push * master)",
      "Exec(git push *:main)",
      "Exec(gws *--yes*)",
      "Write(~/**/.zshenv)",
      "Write(~/**/.zsh_aliases)",
      "Write(~/**/.zsh_plugins.txt)",
      "Read(~/.ssh/**)",
      "Read(~/.npmrc)",
      "Write(~/.ssh/**)",
      "Write(~/.npmrc)"
    ],
    "ask": [
      "Exec(gh pr merge *)",
      "Exec(gh repo edit *)",
      "Exec(gh secret *)",
      "Exec(gh variable *)",
      "Write(**/.github/workflows/**)"
    ]
  },
  "sandbox": {
    "allowed_domains": [
      "github.com",
      "**.github.com",
      "**.githubusercontent.com",
      "registry.npmjs.org",
      "pypi.org",
      "files.pythonhosted.org",
      "firewall-api.socket.dev",
      "registry.terraform.io",
      "releases.hashicorp.com",
      "developer.hashicorp.com",
      "registry.opentofu.org",
      "developers.cloudflare.com",
      "docs.claude.com",
      "docs.anthropic.com",
      "bun.sh",
      "docs.astral.sh",
      "developer.mozilla.org",
      "doc.rust-lang.org",
      "static.crates.io",
      "index.crates.io",
      "proxy.golang.org",
      "devin.ai",
      "**.devin.ai",
      "sum.golang.org",
      "go.dev",
      "dl.google.com",
      "api.cloudflare.com",
      "**.cloudflare.com",
      "github.dev",
      "ghcr.io",
      "**.npmjs.org",
      "crates.io",
      "**.pythonhosted.org",
      "**.posthog.com"
    ],
    "denied_domains": [],
    "network_mode": "full",
    "excluded": {
      "allow": [
        "Exec(git push *)",
        "Exec(git fetch *)",
        "Exec(git pull *)",
        "Exec(gh *)",
        "Exec(depot *)",
        "Exec(git ls-remote *)",
        "Exec(gws)",
        "Exec(gws *)",
        "Exec(git -C * push *)",
        "Exec(git -C * fetch *)",
        "Exec(git -C * pull *)",
        "Exec(git -C * ls-remote *)"
      ]
    }
  }
}
