# Linked to ~/.ssh/config by install.sh. Tracked in a public repo, so it holds
# no secrets, private hosts or other identities: scripts/check-ssh.sh
# (pre-commit and CI) only allows the directives in its allowlist. Per-machine
# hosts and other accounts go in ~/.ssh/config.local (untracked), included here.
Include config.local

# Default GitHub identity (taraxvoid); used by plain git@github.com: remotes
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_github-taraxvoid
    IdentitiesOnly yes
    ServerAliveInterval 30

Host *
    AddKeysToAgent yes
