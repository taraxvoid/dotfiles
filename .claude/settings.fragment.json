{
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "depot *",
      "git ls-remote *",
      "git push *",
      "git fetch *",
      "git pull *",
      "gh *",
      "gws",
      "gws *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "~/.bun/install/cache",
        "~/.local/share/mise",
        "~/.claude/plans",
        "~/Library/Preferences/.wrangler",
        "~/Library/pnpm",
        "~/Library/Caches/pnpm",
        "~/.local/state/pnpm",
        "~/.cache/aube",
        "~/.local/share/aube",
        "~/Library/Caches/aube",
        "~/worktrees"
      ],
      "denyWrite": [
        "~/**/.zshenv",
        "~/**/.zsh_aliases",
        "~/**/.zsh_plugins.txt"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "firewall-api.socket.dev",
        "registry.terraform.io"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.npmrc",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/scripts/statusline.sh"
  },
  "permissions": {
    "allow": [
      "Bash(gh api repos/*)",
      "Bash(gh api /repos/*)",
      "Bash(gh api user)",
      "Bash(gh api rate_limit)"
    ],
    "deny": [
      "Bash(git worktree remove*)",
      "Bash(git worktree prune*)",
      "Bash(rm -rf ~/worktrees*)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(gh auth token*)",
      "Bash(gh api *DELETE*)",
      "Bash(gh api * -X*)",
      "Bash(gh api * --method*)",
      "Bash(gh api * --input*)",
      "Bash(gh api repos/* -f*)",
      "Bash(gh api repos/* -F*)",
      "Bash(gh api repos/* --field*)",
      "Bash(gh api repos/* --raw-field*)",
      "Bash(gh api /repos/* -f*)",
      "Bash(gh api /repos/* -F*)",
      "Bash(gh api /repos/* --field*)",
      "Bash(gh api /repos/* --raw-field*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push *:main)",
      "Bash(rm -rf ~/worktrees*)",
      "Bash(gws *--yes*)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/gws --refresh --bg"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/stop-orphan-check.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/require-worktree.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/require-worktree.sh",
            "if": "Bash(git commit*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/gh-api-guard.sh",
            "if": "Bash(gh *)"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/worktree-create.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/worktree-remove.sh"
          }
        ]
      }
    ]
  }
}
