{
  "obsolete": {
    "excludedCommands": ["git pull *"],
    "allowWrite": ["~/.local/share/mise"]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "depot *",
      "git ls-remote *",
      "git push *",
      "git fetch *",
      "gh *",
      "gws",
      "gws *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "~/.bun/install/cache",
        "~/.claude/plans",
        "~/Library/Preferences/.wrangler",
        "~/Library/pnpm",
        "~/Library/Caches/pnpm",
        "~/.local/state/pnpm",
        "~/.cache/aube",
        "~/.local/share/aube",
        "~/Library/Caches/aube",
        "~/worktrees"
      ],
      "denyWrite": [
        "~/**/.zshenv",
        "~/**/.zsh_aliases",
        "~/**/.zsh_plugins.txt",
        "~/projects/personal/dotfiles/.claude",
        "~/projects/personal/dotfiles/.config",
        "~/projects/personal/dotfiles/.local/bin",
        "~/projects/personal/dotfiles/.ssh",
        "~/projects/personal/dotfiles/.gitconfig",
        "~/projects/personal/dotfiles/.bunfig.toml"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "firewall-api.socket.dev",
        "registry.terraform.io",
	"releases.hashicorp.com",
	"developer.hashicorp.com",
	"registry.opentofu.org",
	"developers.cloudflare.com",
	"docs.claude.com",
	"aube.sh",
	"jdx.dev",
	"docs.anthropic.com",
	"bun.sh",
	"docs.astral.sh",
	"developer.mozilla.org",
	"doc.rust-lang.org",
	"static.crates.io",
	"index.crates.io",
	"proxy.golang.org"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.npmrc",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_ENTERPRISE_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/scripts/statusline.sh"
  },
  "permissions": {
    "allow": [
      "Bash(gh api repos/*)",
      "Bash(gh api /repos/*)",
      "Bash(gh api user)",
      "Bash(gh api rate_limit)",
      "Bash(gh aw compile --strict*)",
      "Bash(gh reply-thread *)",
      "Bash(gh resolve-thread *)"
    ],
    "deny": [
      "Bash(git worktree remove*)",
      "Bash(git worktree prune*)",
      "Bash(rm -rf ~/worktrees*)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(gh auth token*)",
      "Bash(gh auth status*-t*)",
      "Bash(gh auth status*--show-token*)",
      "Bash(gh auth login*)",
      "Bash(gh auth refresh*)",
      "Bash(gh auth setup-git*)",
      "Bash(gh alias set*)",
      "Bash(gh alias import*)",
      "Bash(gh extension *)",
      "Bash(gh ext *)",
      "Bash(gh config set*)",
      "Bash(gh codespace *)",
      "Bash(gh pr checkout*)",
      "Bash(gh repo clone*)",
      "Bash(gh repo fork*)",
      "Bash(gh cs *)",
      "Bash(gh api *DELETE*)",
      "Bash(gh api * -X*)",
      "Bash(gh api * --method*)",
      "Bash(gh api * --input*)",
      "Bash(gh api repos/* -f*)",
      "Bash(gh api repos/* -F*)",
      "Bash(gh api repos/* --field*)",
      "Bash(gh api repos/* --raw-field*)",
      "Bash(gh api /repos/* -f*)",
      "Bash(gh api /repos/* -F*)",
      "Bash(gh api /repos/* --field*)",
      "Bash(gh api /repos/* --raw-field*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push *:main)",
      "Bash(git push *:master)",
      "Bash(git push * main *)",
      "Bash(git push * master *)",
      "Bash(git push *:main *)",
      "Bash(git push *:master *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *refs/heads/master*)",
      "Bash(git push *--all*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete*)",
      "Bash(git push * :*)",
      "Bash(gws *--yes*)"
    ],
    "ask": [
      "Edit(**/.github/workflows/**)",
      "Write(**/.github/workflows/**)",
      "Bash(gh gist create*)",
      "Bash(gh pr merge *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/gws --refresh --bg"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/stop-orphan-check.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/require-worktree.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/require-worktree.sh",
            "if": "Bash(git commit*)"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/gh-aw-frontmatter-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/gh-aw-pre-push.sh",
            "if": "Bash(git push*)",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/git-push-no-verify.sh",
            "if": "Bash(git push*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/git-remote-guard.sh",
            "if": "Bash(git *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/gh-api-guard.sh",
            "if": "Bash(gh *)"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/worktree-create.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/worktree-remove.sh"
          }
        ]
      }
    ]
  }
}
