# Global git config. Per-machine or private settings (signing keys, credentials,
# work identities) go in ~/.gitconfig.local, which is not tracked.
[user]
	name = void
	email = 1711810+taraxvoid@users.noreply.github.com
[init]
	defaultBranch = main
	templateDir = ~/.config/git/template
[pull]
	ff = only
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[fetch]
	prune = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[merge]
	conflictStyle = diff3
# syntax-aware merges. Which files use it is set in ~/.config/git/attributes
# (git's default core.attributesFile, linked by install.sh). Where mergiraf is
# not installed (it comes from brew), git merge-file does git's usual line merge.
[merge "mergiraf"]
	name = mergiraf
	driver = command -v mergiraf >/dev/null && exec mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L || exec git merge-file -L %X -L %S -L %Y %A %O %B
[rerere]
	enabled = true
	autoUpdate = true
[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
	renames = true
[commit]
	verbose = true
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[column]
	ui = auto
[help]
	autocorrect = prompt
# verify every object fetched or pushed. A few old repos fail this on clone; use
# git -c transfer.fsckObjects=false clone ... for those
[transfer]
	fsckObjects = true
# delta when it runs (mise global config), plain less otherwise. Checked by
# running it, since a mise shim can exist without an active version.
[core]
	pager = delta --version >/dev/null 2>&1 && exec delta || exec less
	editor = vim
	untrackedCache = true
[interactive]
	diffFilter = delta --version >/dev/null 2>&1 && exec delta --color-only || exec cat
[delta]
	navigate = true
[alias]
	br = branch
	ci = commit
	cim = commit -m
	co = checkout
	cob = checkout -b
	# difftastic on most recent commit
	ds = -c diff.external=difft show --ext-diff
	# difftastic on unstaged changes
	dt = -c diff.external=difft diff
	ft = fetch --all
	pl = pull
	pul = pull
	ps = push
	psh = push
	pu = push
	st = status
	sta = stash
	stal = stash list
	stap = stash pop
	sw = switch -
	worktrees = !git worktree list
	prunetrees = !git worktree prune
# gh as the HTTPS credential helper (resolved from PATH so it works with brew or apt)
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[include]
	path = ~/.gitconfig.local
